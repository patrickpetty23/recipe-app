// ──────────────────────────────────────────────
// INGREDIENT PARSER — extracted to src/parser.js
// ──────────────────────────────────────────────
import {
  setParserDeps,
  normalizeUnitValue, hasInstructionVerb, ingredientNameQuality,
  isLikelyIngredientLine, parseIngredientLine, parseIngredientsFromLines,
  parseAmount, formatAmount, combineQuantities, scaleRecipeIngredients,
  linesFromTesseractData, linesFromCloudPayload, extractionScore,
  tokenizeAlpha, normalizeText, normalizeUnitToken, normalizeQuantityToken,
  isQuantityToken, scaleQuantity, looksLikeIngredientName,
  isReadableIngredientName, splitFusedMeasurementTokens,
} from "./src/parser.js";


function shoppingListFromRecipe(recipe) {
  return {
    id: uid(),
    createdAt: new Date().toISOString(),
    items: recipe.ingredients
      .filter((i) => i.name?.trim())
      .map((i) => ({
        id: uid(),
        name: i.name.trim(),
        quantity: trimToNull(i.quantity),
        unit: trimToNull(i.unit),
        isChecked: false,
        mlInsight: null,
        sourceRecipeIDs: [recipe.id],
      })),
  };
}

function mergeShoppingListFromRecipes(recipes) {
  const index = new Map();
  for (const recipe of recipes) {
    for (const ing of recipe.ingredients) {
      const name = String(ing.name || "").trim();
      if (!name) continue;
      const unit = trimToNull(ing.unit);
      const key = shoppingMergeKey(name, unit);
      const existing = index.get(key);
      if (!existing) {
        index.set(key, {
          id: uid(),
          name,
          quantity: trimToNull(ing.quantity),
          unit,
          isChecked: false,
          mlInsight: null,
          sourceRecipeIDs: [recipe.id],
        });
      } else {
        existing.quantity = combineQuantities(existing.quantity, ing.quantity);
        if (!existing.sourceRecipeIDs.includes(recipe.id))
          existing.sourceRecipeIDs.push(recipe.id);
      }
    }
  }
  return {
    id: uid(),
    createdAt: new Date().toISOString(),
    items: Array.from(index.values()).sort((a, b) =>
      a.name.localeCompare(b.name),
    ),
  };
}

function shoppingListFromMealPlan(entries) {
  const index = new Map();
  for (const entry of entries) {
    const recipe = recipeById(entry.recipeId);
    if (!recipe) continue;
    const baseServings = Number(recipe.meta?.servings);
    const override = Number(entry.servingsOverride);
    const factor =
      Number.isFinite(baseServings) &&
      baseServings > 0 &&
      Number.isFinite(override) &&
      override > 0
        ? override / baseServings
        : 1;
    const scaledIngredients = scaleRecipeIngredients(recipe, factor);
    for (const ing of scaledIngredients) {
      const name = String(ing.name || "").trim();
      if (!name) continue;
      const unit = trimToNull(ing.unit);
      const key = shoppingMergeKey(name, unit);
      const existing = index.get(key);
      if (!existing) {
        index.set(key, {
          id: uid(),
          name,
          quantity: trimToNull(ing.quantity),
          unit,
          isChecked: false,
          mlInsight: null,
          sourceRecipeIDs: [recipe.id],
          sourcePlanEntries: [entry.id],
        });
      } else {
        existing.quantity = combineQuantities(existing.quantity, ing.quantity);
        if (!existing.sourceRecipeIDs.includes(recipe.id))
          existing.sourceRecipeIDs.push(recipe.id);
        if (!existing.sourcePlanEntries.includes(entry.id))
          existing.sourcePlanEntries.push(entry.id);
      }
    }
  }
  const list = {
    id: uid(),
    createdAt: new Date().toISOString(),
    items: Array.from(index.values()).sort((a, b) =>
      a.name.localeCompare(b.name),
    ),
  };
  list.planEntryIDs = entries.map((entry) => entry.id);
  list.source = "meal_plan";
  return list;
}

function enrichIngredientFields(ing) {
  const enriched = { ...ing };
  const missingQty = !trimToNull(enriched.quantity);
  const missingUnit = !trimToNull(enriched.unit);
  if (!enriched.rawLine || (!missingQty && !missingUnit)) return enriched;
  const reparsed = parseIngredientLine(
    String(enriched.rawLine),
    enriched.confidence || 0.6,
  );
  if (!reparsed) return enriched;
  if (missingQty && trimToNull(reparsed.quantity))
    enriched.quantity = trimToNull(reparsed.quantity);
  if (missingUnit && trimToNull(reparsed.unit))
    enriched.unit = trimToNull(reparsed.unit);
  return enriched;
}

function deriveRecipeName(rawText) {
  const lines = String(rawText || "")
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter(Boolean);
  if (!lines.length) return "Untitled Recipe";
  const first = lines[0];
  if (first.length > 40 && lines[1]) return lines[1].slice(0, 40);
  return first.slice(0, 40);
}

function extractDraftStepsFromText(rawText) {
  const lines = String(rawText || "")
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);
  if (!lines.length) return [];

  let inInstructions = false;
  const steps = [];

  for (const line of lines) {
    const lower = line.toLowerCase();
    if (/^(instructions?|directions?|method|steps?)[:\s-]*$/i.test(line)) {
      inInstructions = true;
      continue;
    }

    const numbered = line.match(/^(?:step\s*)?(\d+)[.)]\s*(.+)$/i);
    if (numbered) {
      steps.push({
        step: steps.length + 1,
        instruction: numbered[2].trim(),
        temperature: null,
        duration: null,
      });
      inInstructions = true;
      continue;
    }

    if (inInstructions) {
      if (isLikelyIngredientLine(line) && steps.length > 0) break;
      steps.push({
        step: steps.length + 1,
        instruction: line,
        temperature: null,
        duration: null,
      });
      continue;
    }

    if (hasInstructionVerb(lower) && line.length > 20) {
      steps.push({
        step: steps.length + 1,
        instruction: line,
        temperature: null,
        duration: null,
      });
      inInstructions = true;
    }
  }

  return steps;
}

async function runUrlImport(sourceUrl) {
  const response = await fetch(URL_IMPORT_API_ENDPOINT, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ url: sourceUrl }),
  });
  const data = await response.json();
  if (!response.ok || !data.ok) {
    throw new Error(data.error || "URL import failed.");
  }
  return data;
}

function applyDraftFromImportPayload(payload) {
  const sourceUrl = cleanUrl(payload?.sourceUrl || "");
  const sourceType = normalizeSourceType(
    payload?.sourceType || inferSourceTypeFromUrl(sourceUrl),
  );
  const sourceTitle =
    trimToNull(payload?.sourceTitle) ||
    hostFromUrl(sourceUrl) ||
    sourceTypeLabel(sourceType);
  const rawText = String(payload?.rawText || "").trim();
  const ingredients = Array.isArray(payload?.ingredients)
    ? payload.ingredients.map(normalizeIngredient).filter(Boolean)
    : [];
  const steps = Array.isArray(payload?.steps)
    ? payload.steps.map(normalizeStep).filter(Boolean)
    : [];

  state.showEditor = true;
  state.selectedImageDataUrl = null;
  state.selectedImages = [];
  state.rawOCRText = rawText;
  state.ocrConfidence = Number.isFinite(Number(payload?.importConfidence))
    ? clamp(Number(payload.importConfidence))
    : rawText
      ? 0.9
      : 0;
  state.ocrSource =
    payload?.importSourceLabel ||
    (sourceType === "social_url" ? "social draft import" : "URL draft import");
  state.droppedOCRLines = Array.isArray(payload?.droppedLines)
    ? payload.droppedLines
    : [];
  state.draftIngredients = ingredients;
  state.draftSteps = steps.length
    ? steps
    : rawText
      ? extractDraftStepsFromText(rawText)
      : [];
  state.lowConfidenceWarning =
    payload?.warning ||
    (rawText
      ? "Imported from fetched or pasted text. Review ingredients and steps before saving."
      : "Link-only draft created. Add ingredients and steps manually before saving.");
  if (sourceType === "social_url" && !rawText) {
    state.lowConfidenceWarning =
      payload?.warning ||
      "Social links often need pasted caption text for better ingredient and step extraction.";
  }
  state.scanErrorMessage = null;
  resetDraftMetadata();
  state.draftRecipeName =
    trimToNull(payload?.name) ||
    (rawText ? deriveRecipeName(rawText) : sourceTitle);
  applyDraftImportMetadata(
    sourceType,
    trimToNull(payload?.importMethod) || "url_draft",
    {
      sourceTitle,
      sourceUrl,
      description:
        trimToNull(payload?.description) ||
        (sourceType === "social_url"
          ? "Draft created from a social recipe link. Review and complete details before saving."
          : "Draft created from a recipe URL. Review and complete details before saving."),
    },
  );
  if (sourceType === "social_url" && !state.draftTags.includes("social"))
    state.draftTags.push("social");

  logEvent("info", "url_draft_created", {
    source_type: sourceType,
    has_text: rawText ? "true" : "false",
    ingredient_count: state.draftIngredients.length,
    step_count: state.draftSteps.length,
  });

  saveState();
  renderAll();
}

async function createDraftFromUrlImport() {
  const sourceUrl = cleanUrl(dom.recipeUrlInput?.value || "");
  const rawText = String(dom.recipeTextInput?.value || "").trim();

  if (!sourceUrl) {
    state.scanErrorMessage = "Paste a recipe or social URL first.";
    renderScanStatus();
    return;
  }

  if (rawText) {
    const textLines = rawText
      .split(/\r?\n/)
      .map((line) => ({ text: line.trim(), confidence: 0.9 }))
      .filter((line) => line.text);
    const parsed = textLines.length
      ? parseIngredientsFromLines(textLines)
      : { ingredients: [], droppedLines: [] };
    applyDraftFromImportPayload({
      sourceUrl,
      sourceType: inferSourceTypeFromUrl(sourceUrl),
      sourceTitle: hostFromUrl(sourceUrl),
      importMethod: "url_draft",
      importSourceLabel:
        inferSourceTypeFromUrl(sourceUrl) === "social_url"
          ? "social draft import"
          : "URL draft import",
      rawText,
      ingredients: parsed.ingredients || [],
      droppedLines: parsed.droppedLines || [],
      steps: extractDraftStepsFromText(rawText),
      importConfidence: 0.9,
      warning:
        "Imported from pasted text. Review ingredients and steps before saving.",
    });
    return;
  }

  state.scanErrorMessage = null;
  state.lowConfidenceWarning = null;
  state.isProcessing = true;
  state.ui.extractProgress = "Fetching recipe URL...";
  renderAll();

  try {
    const result = await runUrlImport(sourceUrl);
    applyDraftFromImportPayload(result.result || {});
  } catch (error) {
    state.scanErrorMessage =
      error instanceof Error ? error.message : String(error);
    logEvent("error", "url_import_failed", { error: state.scanErrorMessage });
    renderScanStatus();
  } finally {
    state.isProcessing = false;
    state.ui.extractProgress = "";
    renderAll();
  }
}

function addBlankStep() {
  state.draftSteps.push({
    step: state.draftSteps.length + 1,
    instruction: "",
    temperature: null,
    duration: null,
  });
  renderEditor();
}

function removeStep(idx) {
  if (idx < 0 || idx >= state.draftSteps.length) return;
  state.draftSteps.splice(idx, 1);
  state.draftSteps = state.draftSteps.map((step, index) => ({
    ...step,
    step: index + 1,
  }));
  renderEditor();
}

function findPotentialDuplicateRecipe(candidate) {
  const candidateTitle = normalizeRecipeTitle(candidate.name);
  const candidateUrl = cleanUrl(candidate.sourceUrl);
  const candidateIngredients = new Set(
    (candidate.ingredients || [])
      .map((ing) => normalizeIngredientName(ing.name))
      .filter(Boolean),
  );

  for (const existing of state.recipes) {
    const existingTitle = normalizeRecipeTitle(existing.name);
    const existingUrl = cleanUrl(existing.sourceUrl);

    if (candidateUrl && existingUrl && candidateUrl === existingUrl) {
      return { recipe: existing, reason: "same source URL" };
    }

    if (candidateTitle && existingTitle && candidateTitle === existingTitle) {
      return { recipe: existing, reason: "matching title" };
    }

    const existingIngredients = new Set(
      (existing.ingredients || [])
        .map((ing) => normalizeIngredientName(ing.name))
        .filter(Boolean),
    );
    const overlap = [...candidateIngredients].filter((name) =>
      existingIngredients.has(name),
    ).length;
    if (
      candidateIngredients.size >= 3 &&
      overlap >=
        Math.min(candidateIngredients.size, existingIngredients.size, 3)
    ) {
      return { recipe: existing, reason: "high ingredient overlap" };
    }
  }

  return null;
}

function commitRecipeSave(recipe) {
  state.recipes.unshift(recipe);
  if (state.recipes.length > 50) state.recipes = state.recipes.slice(0, 50);

  const newList = shoppingListFromRecipe(recipe);
  const existing = state.activeShoppingList;
  if (existing && Array.isArray(existing.items) && existing.items.length) {
    showConfirm(
      "Shopping List Already Exists",
      `You have ${existing.items.length} item${existing.items.length !== 1 ? "s" : ""} in your current shopping list. Merge the new recipe into it, or replace it?`,
      () => {
        // Merge new recipe items into existing list, combining duplicates
        const index = new Map();
        for (const item of existing.items) {
          const key = shoppingMergeKey(item.name, item.unit);
          index.set(key, { ...item });
        }
        for (const item of newList.items) {
          const key = shoppingMergeKey(item.name, item.unit);
          const match = index.get(key);
          if (match) {
            match.quantity = combineQuantities(match.quantity, item.quantity);
            if (!match.sourceRecipeIDs) match.sourceRecipeIDs = [];
            for (const rid of item.sourceRecipeIDs || []) {
              if (!match.sourceRecipeIDs.includes(rid)) match.sourceRecipeIDs.push(rid);
            }
          } else {
            index.set(key, { ...item });
          }
        }
        state.activeShoppingList = {
          id: existing.id,
          createdAt: existing.createdAt,
          items: Array.from(index.values()),
        };
        saveState();
        renderAll();
      },
    );
    // Default action (Cancel on confirm) keeps existing list untouched.
    // Recipe is already saved above, so no data loss either way.
    return;
  }
  state.activeShoppingList = newList;
  state.showEditor = false;
  state.selectedImageDataUrl = null;
  state.selectedImages = [];
  state.rawOCRText = "";
  state.droppedOCRLines = [];
  state.ocrConfidence = 0;
  state.ocrSource = null;
  state.scanErrorMessage = null;
  state.lowConfidenceWarning = null;
  resetDraftMetadata();
  state.draftIngredients = [];
  state.draftSteps = [];
  state.mealAnalysis = null;
  state.mealImageDataUrl = null;
  state.usedSample = false;

  logEvent("info", "recipe_saved", {
    recipe_id: recipe.id,
    ingredient_count: recipe.ingredients.length,
    source_type: recipe.sourceType,
  });
  saveState();
  showView("shopping-view");
}

// ──────────────────────────────────────────────
// RENDER FUNCTIONS
// ──────────────────────────────────────────────

function confidenceClass(v) {
  return v >= 0.8 ? "conf-high" : v >= 0.5 ? "conf-mid" : "conf-low";
}

function quantityLabel(item) {
  const j = [item.quantity || "", item.unit || ""].join(" ").trim();
  return j || "—";
}

function renderViews() {
  const active = state.ui.activeView;
  dom.views.forEach((v) => v.classList.toggle("active", v.id === active));
  dom.tabs.forEach((t) =>
    t.classList.toggle("active", t.dataset.view === active),
  );
}

function renderNav() {
  const meta = NAV_META[state.ui.activeView] || NAV_META["scan-view"];
  dom.navTitle.textContent = meta.title;
  if (!meta.action) {
    setHidden(dom.navAction, true);
    return;
  }
  setHidden(dom.navAction, false);
  if (meta.action === "merge") {
    const plannedCount = plannedEntriesForSelectedWeek().length;
    dom.navAction.textContent = plannedCount ? "Plan Shop" : "Shop All";
    dom.navAction.disabled = plannedCount ? false : state.recipes.length < 2;
    dom.navAction.style.color = "";
  } else if (meta.action === "clear") {
    dom.navAction.textContent = "Clear";
    dom.navAction.disabled = !state.activeShoppingList;
    dom.navAction.style.color = "var(--danger)";
  }
}

function renderScanImage() {
  const images = state.selectedImages;

  if (images.length > 0) {
    setHidden(dom.photoGrid, false);
    dom.photoGrid.innerHTML =
      images
        .map(
          (url, i) => `
      <div class="photo-thumb">
        <img src="${escapeHtml(url)}" alt="Photo ${i + 1}">
        <button class="remove-photo" data-action="remove-photo" data-index="${i}">✕</button>
      </div>
    `,
        )
        .join("") +
      `
      <button class="photo-thumb-add" id="add-more-photos-btn" title="Add more photos">+</button>
    `;
    dom.imagePreview.innerHTML = "";
    setHidden(dom.imagePreview, true);
  } else if (state.selectedImageDataUrl) {
    setHidden(dom.photoGrid, true);
    setHidden(dom.imagePreview, false);
    dom.imagePreview.innerHTML = `<img src="${escapeHtml(state.selectedImageDataUrl)}" alt="Recipe image">`;
  } else {
    setHidden(dom.photoGrid, true);
    setHidden(dom.imagePreview, false);
    dom.imagePreview.innerHTML = `
      <div class="placeholder" id="image-placeholder">
        <div class="placeholder-icon">📋</div>
        <p>No image selected</p>
        <button class="btn btn-ghost" id="try-sample-btn">Try with Sample Recipe</button>
      </div>`;
    const btn = document.getElementById("try-sample-btn");
    if (btn) btn.addEventListener("click", loadSampleRecipe);
  }
}

function renderScanStatus() {
  dom.extractBtn.disabled =
    (!state.selectedImageDataUrl && !state.selectedImages.length) ||
    state.isProcessing;
  dom.extractBtn.textContent = state.isProcessing
    ? "Processing…"
    : "Extract Ingredients";
  dom.extractProgress.textContent = state.ui.extractProgress || "";

  const warn = state.lowConfidenceWarning || "";
  dom.warningMsg.textContent = warn;
  setHidden(dom.warningMsg, !warn);

  const err = state.scanErrorMessage || "";
  dom.errorMsg.textContent = err;
  setHidden(dom.errorMsg, !err);

  if (state.ocrConfidence > 0) {
    setHidden(dom.confidenceBox, false);
    const pct = Math.round(state.ocrConfidence * 100);
    dom.ocrConfValue.textContent = `${pct}%`;
    dom.ocrConfBar.style.width = `${pct}%`;
    dom.ocrSourceLabel.textContent = `source: ${state.ocrSource || "—"}`;
  } else {
    setHidden(dom.confidenceBox, true);
  }
}

function renderScanMode() {
  const isRecipe = state.scanMode === "recipe";
  dom.modeRecipeBtn.classList.toggle("active", isRecipe);
  dom.modeMealBtn.classList.toggle("active", !isRecipe);
  setHidden(dom.recipeMode, !isRecipe);
  setHidden(dom.mealMode, isRecipe);
}

function renderMealMode() {
  if (state.scanMode !== "meal") return;

  if (state.mealImageDataUrl) {
    dom.mealImagePreview.innerHTML = `<img src="${escapeHtml(state.mealImageDataUrl)}" alt="Meal photo">`;
    dom.analyzeMealBtn.disabled = state.isProcessing;
  } else {
    dom.mealImagePreview.innerHTML = `
      <div class="placeholder">
        <div class="placeholder-icon">🍽️</div>
        <p>No meal photo selected</p>
        <button class="btn btn-ghost" id="try-sample-meal-btn">Try with Sample Meal</button>
      </div>`;
    dom.analyzeMealBtn.disabled = true;
    const btn = document.getElementById("try-sample-meal-btn");
    if (btn) btn.addEventListener("click", loadSampleMeal);
  }

  dom.analyzeMealBtn.textContent = state.isProcessing
    ? "Analyzing…"
    : "🤖 Identify Meal & Generate Recipe";
  dom.mealProgress.textContent = state.ui.mealProgress || "";

  const err = state.ui.mealError || "";
  dom.mealErrorMsg.textContent = err;
  setHidden(dom.mealErrorMsg, !err);
}

function renderRecipes() {
  renderMealPlanner();
  const recipes = filteredRecipes();
  if (
    dom.recipesSearchInput &&
    dom.recipesSearchInput.value !== state.ui.recipeSearch
  ) {
    dom.recipesSearchInput.value = state.ui.recipeSearch || "";
  }
  if (
    dom.recipesSourceFilter &&
    dom.recipesSourceFilter.value !== state.ui.recipeSourceFilter
  ) {
    dom.recipesSourceFilter.value = state.ui.recipeSourceFilter || "all";
  }
  if (
    dom.recipesSortSelect &&
    dom.recipesSortSelect.value !== state.ui.recipeSort
  ) {
    dom.recipesSortSelect.value = state.ui.recipeSort || "newest";
  }
  if (dom.recipesCompatibleOnly) {
    dom.recipesCompatibleOnly.checked = !!state.ui.recipesCompatibleOnly;
  }

  if (!recipes.length) {
    setHidden(dom.recipesEmpty, false);
    dom.recipesList.innerHTML = "";
    return;
  }
  setHidden(dom.recipesEmpty, true);
  dom.recipesList.innerHTML = recipes
    .map((r) => {
      const sourceSummary = sourceMetaSummary(r);
      const compatibility = recipeCompatibilityReport(r);
      const nutritionBadges = nutritionBadgesForRecipe(r);
      const compatibilityLabel =
        compatibility.status === "ok"
          ? "Compatible"
          : `${compatibility.issues.length} issue${compatibility.issues.length === 1 ? "" : "s"}`;
      const compatibilityClass =
        compatibility.status === "ok"
          ? "compatibility-ok"
          : "compatibility-block";
      const tagRow =
        Array.isArray(r.tags) && r.tags.length
          ? `<div class="tag-row">${r.tags.map((tag) => `<button class="tag-chip" data-action="filter-tag" data-tag="${escapeHtml(tag)}">${escapeHtml(tag)}</button>`).join("")}</div>`
          : "";
      const nutritionBadgeRow = nutritionBadges.length
        ? `<div class="tag-row">${nutritionBadges.map((badge) => `<span class="tag-chip nutrition-chip">${escapeHtml(badge)}</span>`).join("")}</div>`
        : "";
      return `
      <article class="recipe-card" data-recipe-id="${escapeHtml(r.id)}">
        <div class="recipe-source-chip">${escapeHtml(sourceTypeLabel(r.sourceType))}</div>
        <h4>${escapeHtml(r.name)}</h4>
        <p class="recipe-meta">${escapeHtml(sourceSummary)} - ${r.ingredients.length} ingredient${r.ingredients.length !== 1 ? "s" : ""} - ${escapeHtml(formatDate(r.createdAt))}</p>
        <div class="recipe-compatibility-row">
          <span class="compatibility-status ${compatibilityClass}">${escapeHtml(compatibilityLabel)}</span>
          <span class="meta-text">${escapeHtml(compatibility.summary)}</span>
        </div>
        ${nutritionBadgeRow}
        ${tagRow}
        <div class="recipe-actions">
          <button class="btn btn-secondary btn-mini" data-action="open-detail" data-recipe-id="${escapeHtml(r.id)}">View</button>
          <button class="btn btn-primary btn-mini" data-action="plan-recipe" data-recipe-id="${escapeHtml(r.id)}">Plan ${escapeHtml(mealSlotLabel(state.ui.mealPlanSelectedSlot || "dinner"))}</button>
          <button class="btn btn-secondary btn-mini" data-action="generate-list" data-recipe-id="${escapeHtml(r.id)}">Shop</button>
          <button class="btn btn-danger btn-mini" data-action="delete-recipe" data-recipe-id="${escapeHtml(r.id)}">Delete</button>
        </div>
      </article>
    `;
    })
    .join("");
}

function formatMLBuyingAdvice(mlInsight) {
  if (!mlInsight) return "";
  const name = mlInsight.pantryName || "this item";
  const days = mlInsight.predictedDays;
  const useBy = mlInsight.finalUseByDate;

  let advice = "";
  if (days !== null && days !== undefined && Number.isFinite(days)) {
    if (days <= 3) {
      advice = `Your ${name} will likely run out in the next few days. Buy it this trip.`;
    } else if (days <= 7) {
      advice = `Your ${name} should last about ${Math.round(days)} more days. You can buy it now or wait until next week.`;
    } else {
      advice = `Your ${name} still has about ${Math.round(days)} days left. You probably don't need to buy more yet.`;
    }
  } else if (useBy) {
    advice = `Your ${name} should be used by ${useBy}.`;
  } else {
    advice = `Freshness check complete for ${name}.`;
  }

  return advice;
}

function renderShopping() {
  const list = state.activeShoppingList;
  if (!list || !Array.isArray(list.items) || !list.items.length) {
    setHidden(dom.shoppingEmpty, false);
    setHidden(dom.shoppingSummary, true);
    dom.shoppingList.innerHTML = "";
    return;
  }

  setHidden(dom.shoppingEmpty, true);
  const total = list.items.length;
  const checked = list.items.filter((i) => i.isChecked).length;
  const pct = total ? Math.round((checked / total) * 100) : 0;
  const circumference = 2 * Math.PI * 17;
  const offset = circumference - (pct / 100) * circumference;

  setHidden(dom.shoppingSummary, false);
  dom.shoppingSummary.innerHTML = `
    <svg class="shopping-progress-ring" viewBox="0 0 44 44">
      <circle class="ring-bg" cx="22" cy="22" r="17"/>
      <circle class="ring-fill" cx="22" cy="22" r="17"
        stroke-dasharray="${circumference}" stroke-dashoffset="${offset}"/>
    </svg>
    <div class="shopping-summary-text">
      <strong>${checked} of ${total} items</strong>
      <p>${pct}% complete${list.source === "meal_plan" ? " - generated from weekly meal plan" : ""}</p>
    </div>
  `;
  const grouped = new Map();
  for (const item of list.items) {
    const category = inferShoppingCategory(item.name);
    if (!grouped.has(category)) grouped.set(category, []);
    grouped.get(category).push(item);
  }

  const categoryOrder = [
    "Produce",
    "Protein",
    "Dairy",
    "Pantry",
    "Frozen",
    "Other",
  ];
  dom.shoppingList.innerHTML = categoryOrder
    .filter((category) => grouped.has(category))
    .map((category) => {
      const items = grouped.get(category) || [];
      return `
        <section class="settings-card">
          <h3>${escapeHtml(category)}</h3>
          <div class="card-stack">
            ${items
              .map((item) => {
                const recipeNames = (item.sourceRecipeIDs || [])
                  .map((recipeId) => recipeById(recipeId)?.name)
                  .filter(Boolean)
                  .slice(0, 2);
                const sourceHint = recipeNames.length
                  ? ` - from ${recipeNames.join(", ")}${item.sourceRecipeIDs.length > 2 ? "..." : ""}`
                  : "";
              const pantryHint = pantryHintForItem(item);
              const hasPantryMatch = !!pantryHint.match?.item;
              const showMlCheck = hasPantryMatch && pantryHint.kind === "low" && canRunDecayCheck(pantryHint.match.item);
              const mlInsight = item.mlInsight || null;
              return `
                <div class="shopping-item">
                  <input type="checkbox" data-action="toggle-item" data-item-id="${escapeHtml(item.id)}" ${item.isChecked ? "checked" : ""}>
                  <div class="item-info">
                    <div class="item-name ${item.isChecked ? "checked" : ""}">${escapeHtml(item.name)}</div>
                    <div class="item-qty">${escapeHtml(quantityLabel(item))}${list.source === "meal_plan" && item.sourceRecipeIDs?.length ? ` - ${item.sourceRecipeIDs.length} planned recipe${item.sourceRecipeIDs.length !== 1 ? "s" : ""}` : ""}${escapeHtml(sourceHint)}</div>
                    <div class="hint-badge hint-${escapeHtml(pantryHint.kind)}">${escapeHtml(pantryHint.label)}</div>
                    <div class="hint-note">${escapeHtml(pantryHint.note)}</div>
                    ${mlInsight ? `<div class="ml-hint-note">${escapeHtml(formatMLBuyingAdvice(mlInsight))}<span class="ml-assumptions">${mlInsight.usingDefaults ? "Using default assumptions:" : "Based on"} household of ${escapeHtml(String(mlInsight.householdSize || 3))}, ${escapeHtml(String(mlInsight.mealsPerWeek || 7))} meals/wk${mlInsight.usingDefaults ? " \u2014 update in Settings" : ""}</span></div>` : ""}
                    <div class="shopping-actions">
                      <button class="btn btn-secondary btn-mini" type="button" data-action="edit-item-pantry" data-item-id="${escapeHtml(item.id)}">${hasPantryMatch ? "Update Pantry" : "Add to Pantry"}</button>
                      ${showMlCheck ? `<button class="btn btn-secondary btn-mini" type="button" data-action="ml-check-item" data-item-id="${escapeHtml(item.id)}">Check Freshness</button>` : ""}
                    </div>
                  </div>
                </div>
              `;
              })
              .join("")}
          </div>
        </section>
      `;
    })
    .join("");
}

function renderSettings() {
  const dietaryProfile = normalizeDietaryProfile(state.settings?.dietaryProfile);
  dom.cloudToggle.checked = !!state.settings.useCloudFallback;
  dom.thresholdSlider.value = String(state.settings.lowConfidenceThreshold);
  dom.thresholdValue.textContent = String(
    Math.round(state.settings.lowConfidenceThreshold * 100),
  );
  if (dom.dietTypeSelect) dom.dietTypeSelect.value = dietaryProfile.dietType;
  if (dom.allergiesInput) dom.allergiesInput.value = dietaryProfile.allergies.join(", ");
  if (dom.excludedIngredientsInput) dom.excludedIngredientsInput.value = dietaryProfile.excludedIngredients.join(", ");
  if (dom.macroFocusSelect) dom.macroFocusSelect.value = dietaryProfile.macroFocus;
  if (dom.decayDate && !dom.decayDate.value) {
    dom.decayDate.value = todayIsoDate();
  }
  if (dom.decayRunBtn) {
    dom.decayRunBtn.disabled = !!state.decay.pending;
  }
  if (dom.decayProgress) {
    dom.decayProgress.textContent = state.decay.pending
      ? "Running prediction..."
      : "";
  }
  if (dom.decayError) {
    setHidden(dom.decayError, !state.decay.error);
    dom.decayError.textContent = state.decay.error || "";
  }
  if (dom.decayResult && dom.decayUseBy && dom.decayExplanation) {
    const result = state.decay.result;
    setHidden(dom.decayResult, !result);
    if (result) {
      dom.decayUseBy.textContent = result.final_use_by_date || "--";
      dom.decayExplanation.textContent = result.explanation || "";
    }
  }
  if (dom.logsPreview) {
    const tail = state.logs.slice(-20);
    dom.logsPreview.textContent = tail.length
      ? tail.map((entry) => JSON.stringify(entry)).join("\n")
      : "No logs yet.";
  }
}

function sourceMetaSummary(recipe) {
  const parts = [];
  if (recipe.sourceTitle) parts.push(recipe.sourceTitle);
  const host = hostFromUrl(recipe.sourceUrl || "");
  if (host && !parts.includes(host)) parts.push(host);
  if (!parts.length) parts.push(sourceTypeLabel(recipe.sourceType));
  return parts.join(" - ");
}

function filteredRecipes() {
  const search = String(state.ui.recipeSearch || "")
    .trim()
    .toLowerCase();
  const sourceFilter = String(state.ui.recipeSourceFilter || "all");
  const sort = String(state.ui.recipeSort || "newest");
  const compatibleOnly = !!state.ui.recipesCompatibleOnly;

  const filtered = state.recipes.filter((recipe) => {
    if (sourceFilter !== "all" && recipe.sourceType !== sourceFilter) {
      return false;
    }
    if (compatibleOnly && recipeCompatibilityReport(recipe).status !== "ok") {
      return false;
    }
    if (!search) return true;

    const haystack = [
      recipe.name,
      recipe.description,
      recipe.sourceTitle,
      recipe.sourceUrl,
      ...(recipe.tags || []),
    ]
      .filter(Boolean)
      .join(" ")
      .toLowerCase();

    return haystack.includes(search);
  });

  if (sort === "oldest") {
    filtered.sort((a, b) =>
      String(a.createdAt || "").localeCompare(String(b.createdAt || "")),
    );
  } else if (sort === "title") {
    filtered.sort((a, b) =>
      String(a.name || "").localeCompare(String(b.name || "")),
    );
  } else {
    filtered.sort((a, b) =>
      String(b.createdAt || "").localeCompare(String(a.createdAt || "")),
    );
  }

  return filtered;
}

function plannedEntriesForSelectedWeek() {
  const dates = new Set(weekDates(state.ui.mealPlanSelectedDate));
  return state.mealPlanEntries.filter((entry) => dates.has(entry.date));
}

function renderMealPlanner() {
  if (!dom.mealPlanDaySelect || !dom.mealPlanList || !dom.mealPlanRange) return;

  const dates = weekDates(state.ui.mealPlanSelectedDate);
  const first = dates[0];
  const last = dates[dates.length - 1];
  dom.mealPlanRange.textContent = `${formatPlanDateLabel(first)} - ${formatPlanDateLabel(last)}`;
  dom.mealPlanDaySelect.innerHTML = dates
    .map(
      (date) =>
        `<option value="${escapeHtml(date)}" ${date === state.ui.mealPlanSelectedDate ? "selected" : ""}>${escapeHtml(formatPlanDateLabel(date))}</option>`,
    )
    .join("");
  if (
    dom.mealPlanSlotSelect &&
    dom.mealPlanSlotSelect.value !== state.ui.mealPlanSelectedSlot
  ) {
    dom.mealPlanSlotSelect.value = state.ui.mealPlanSelectedSlot || "dinner";
  }

  const weekEntries = plannedEntriesForSelectedWeek();
  if (dom.mealPlanSummary) {
    const totalSlots = dates.length * MEAL_SLOTS.length;
    dom.mealPlanSummary.textContent = `${weekEntries.length} of ${totalSlots} meal slots planned`;
  }
  dom.mealPlanList.innerHTML = dates
    .map((date) => {
      const entriesBySlot = new Map(
        weekEntries
          .filter((entry) => entry.date === date)
          .map((entry) => [`${entry.date}:${entry.mealSlot}`, entry]),
      );
      const slotCards = MEAL_SLOTS.map((slot) => {
        const entry = entriesBySlot.get(`${date}:${slot}`);
        const recipe = entry ? recipeById(entry.recipeId) : null;
        return `
        <div class="detail-ingredient">
          <strong>${escapeHtml(mealSlotLabel(slot))}</strong>
          <p class="recipe-meta">${recipe ? escapeHtml(recipe.name) : "No meal planned"}</p>
          ${entry ? `<p class="recipe-meta">Servings: ${escapeHtml(String(entry.servingsOverride || recipe?.meta?.servings || "default"))}</p>` : ""}
          ${
            recipe && Array.isArray(recipe.tags) && recipe.tags.length
              ? `<div class="tag-row">${recipe.tags.map((tag) => `<span class="tag-chip">${escapeHtml(tag)}</span>`).join("")}</div>`
              : ""
          }
          <div class="recipe-actions">
            ${entry ? `<button class="btn btn-secondary btn-mini" data-action="increase-servings" data-plan-entry-id="${escapeHtml(entry.id)}">+ Serving</button>` : ""}
            ${entry ? `<button class="btn btn-secondary btn-mini" data-action="decrease-servings" data-plan-entry-id="${escapeHtml(entry.id)}">- Serving</button>` : ""}
            ${entry ? `<button class="btn btn-danger btn-mini" data-action="remove-plan-entry" data-plan-entry-id="${escapeHtml(entry.id)}">Remove</button>` : ""}
          </div>
        </div>
      `;
      }).join("");
      return `
      <div class="recipe-card">
        <div class="recipe-source-chip">${escapeHtml(formatPlanDateLabel(date))}</div>
        <h4>${escapeHtml(formatPlanDateLabel(date))}</h4>
        <p class="recipe-meta">Select a day and slot, then use Plan on a recipe below.</p>
        <div class="card-stack">${slotCards}</div>
      </div>
    `;
    })
    .join("");

  if (dom.generatePlanListBtn) {
    dom.generatePlanListBtn.disabled = weekEntries.length === 0;
  }
  if (dom.copyWeekPlanBtn) {
    dom.copyWeekPlanBtn.disabled = weekEntries.length === 0;
  }
}

function renderPantry() {
  if (!dom.pantryList) return;
  if (
    dom.pantryDateInput &&
    !dom.pantryDateInput.value &&
    !state.ui.pantryEditId
  ) {
    dom.pantryDateInput.value = todayIsoDate();
  }

  dom.pantryList.innerHTML = state.pantryItems.length
    ? state.pantryItems
        .map(
          (item) => {
            const mlEligible = canRunDecayCheck(item);
            return `
      <article class="recipe-card">
        <div class="recipe-source-chip">${escapeHtml(item.category || "Other")}</div>
        <h4>${escapeHtml(item.displayName)}</h4>
        <p class="recipe-meta">${escapeHtml(quantityLabel(item))} - bought ${escapeHtml(item.purchaseDate || "unknown")}</p>
        <div class="recipe-actions">
          ${mlEligible ? `<button class="btn btn-secondary btn-mini" data-action="predict-pantry" data-pantry-id="${escapeHtml(item.id)}">Check Freshness</button>` : ""}
          <button class="btn btn-secondary btn-mini" data-action="edit-pantry" data-pantry-id="${escapeHtml(item.id)}">Edit</button>
          <button class="btn btn-danger btn-mini" data-action="delete-pantry" data-pantry-id="${escapeHtml(item.id)}">Delete</button>
        </div>
      </article>
    `;
          },
        )
        .join("")
    : `<div class="empty-state"><div class="empty-icon">🥫</div><h3>No Pantry Items</h3><p>Add items you already have at home. This helps your shopping list show what you need vs. what you can skip.</p></div>`;
}

function resetDraftMetadata() {
  state.draftRecipeName = "";
  state.draftDescription = "";
  state.draftTags = [];
  state.draftNutrition = emptyDraftNutrition();
  state.draftSourceType = "manual_entry";
  state.draftSourceTitle = "";
  state.draftSourceUrl = "";
  state.draftImportMethod = "manual";
}

function beginBlankRecipeDraft() {
  state.showEditor = true;
  state.draftIngredients = [];
  state.draftSteps = [];
  state.droppedOCRLines = [];
  state.rawOCRText = "";
  state.ocrConfidence = 0;
  state.ocrSource = null;
  state.lowConfidenceWarning = null;
  state.scanErrorMessage = null;
  state.mealAnalysis = null;
  state.mealImageDataUrl = null;
  state.selectedImageDataUrl = null;
  state.selectedImages = [];
  resetDraftMetadata();
  state.draftSourceType = normalizeSourceType(
    dom.scanSourceType?.value || "manual_entry",
  );
  renderAll();
}

function applyDraftImportMetadata(sourceType, importMethod, options = {}) {
  state.draftSourceType = normalizeSourceType(sourceType);
  state.draftImportMethod = trimToNull(importMethod) || "manual";
  if (Object.prototype.hasOwnProperty.call(options, "sourceTitle"))
    state.draftSourceTitle = trimToNull(options.sourceTitle) || "";
  if (Object.prototype.hasOwnProperty.call(options, "sourceUrl"))
    state.draftSourceUrl = cleanUrl(options.sourceUrl) || "";
  if (Object.prototype.hasOwnProperty.call(options, "description"))
    state.draftDescription = trimToNull(options.description) || "";
}

function renderEditor() {
  setHidden(dom.editorSheet, !state.showEditor);
  if (!state.showEditor) return;
  const editorTitle = document.getElementById("editor-title");
  if (editorTitle) editorTitle.textContent = state.editingRecipeId ? "Edit Recipe" : "Review Ingredients";
  dom.editorSave.disabled = state.draftIngredients.length === 0;
  dom.recipeNameInput.value = state.draftRecipeName;
  if (dom.recipeDescriptionInput)
    dom.recipeDescriptionInput.value = state.draftDescription || "";
  if (dom.recipeTagsInput)
    dom.recipeTagsInput.value = (state.draftTags || []).join(", ");
  if (dom.editorSourceType)
    dom.editorSourceType.value = normalizeSourceType(state.draftSourceType);
  if (dom.recipeSourceTitleInput)
    dom.recipeSourceTitleInput.value = state.draftSourceTitle || "";
  if (dom.recipeSourceUrlInput)
    dom.recipeSourceUrlInput.value = state.draftSourceUrl || "";
  if (dom.nutritionServingSizeInput)
    dom.nutritionServingSizeInput.value = state.draftNutrition?.servingSize || "";
  if (dom.nutritionCaloriesInput)
    dom.nutritionCaloriesInput.value = state.draftNutrition?.calories || "";
  if (dom.nutritionProteinInput)
    dom.nutritionProteinInput.value = state.draftNutrition?.proteinG || "";
  if (dom.nutritionCarbsInput)
    dom.nutritionCarbsInput.value = state.draftNutrition?.carbsG || "";
  if (dom.nutritionFatInput)
    dom.nutritionFatInput.value = state.draftNutrition?.fatG || "";
  if (dom.nutritionFiberInput)
    dom.nutritionFiberInput.value = state.draftNutrition?.fiberG || "";
  if (dom.nutritionSugarInput)
    dom.nutritionSugarInput.value = state.draftNutrition?.sugarG || "";
  dom.ingredientCountBadge.textContent = String(state.draftIngredients.length);

  dom.ingredientList.innerHTML = state.draftIngredients
    .map((ing, idx) => {
      const pct = Math.round((ing.confidence || 0) * 100);
      return `
      <div class="ingredient-row" data-index="${idx}">
        <div class="ingredient-fields">
          <input type="text" placeholder="Qty" data-field="quantity" data-index="${idx}" value="${escapeHtml(ing.quantity || "")}">
          <input type="text" placeholder="Unit" data-field="unit" data-index="${idx}" value="${escapeHtml(ing.unit || "")}">
          <input type="text" placeholder="Ingredient" data-field="name" data-index="${idx}" value="${escapeHtml(ing.name || "")}">
          <button class="ingredient-delete" data-action="delete-ingredient" data-index="${idx}">✕</button>
        </div>
        <div class="confidence-row">
          <span>Confidence</span>
          <span class="${confidenceClass(ing.confidence || 0)}">${pct}%</span>
        </div>
      </div>`;
    })
    .join("");

  const dropped = state.droppedOCRLines || [];
  if (dropped.length) {
    setHidden(dom.droppedLinesBox, false);
    dom.droppedLinesList.innerHTML = dropped
      .map((l) => `<li>${escapeHtml(l)}</li>`)
      .join("");
    dom.droppedLinesBox.open = true;
  } else {
    setHidden(dom.droppedLinesBox, true);
  }

  // Steps section
  const steps = state.draftSteps || [];
  setHidden(dom.stepsSection, false);
  dom.stepsCountBadge.textContent = String(steps.length);
  dom.stepsList.innerHTML = steps
    .map(
      (s, idx) => `
    <div class="step-card" data-step-index="${idx}">
      <div class="step-header">
        <span class="step-number">${idx + 1}</span>
        <button class="ingredient-delete" data-action="delete-step" data-step-index="${idx}">x</button>
      </div>
      <textarea class="text-input" rows="3" data-step-field="instruction" data-step-index="${idx}" placeholder="Describe this step">${escapeHtml(s.instruction || "")}</textarea>
      <div class="ingredient-fields" style="margin-top:8px">
        <input type="text" placeholder="Temperature" data-step-field="temperature" data-step-index="${idx}" value="${escapeHtml(s.temperature || "")}">
        <input type="text" placeholder="Duration" data-step-field="duration" data-step-index="${idx}" value="${escapeHtml(s.duration || "")}">
      </div>
    </div>
  `,
    )
    .join("");
}

function renderRecipeDetail() {
  const recipe = state.detail.recipeId
    ? state.recipes.find((r) => r.id === state.detail.recipeId)
    : null;
  if (!recipe) {
    setHidden(dom.detailSheet, true);
    return;
  }

  setHidden(dom.detailSheet, false);
  dom.detailTitle.textContent = recipe.name;
  if (dom.detailDescription) {
    setHidden(dom.detailDescription, !recipe.description);
    dom.detailDescription.textContent = recipe.description || "";
  }
  if (dom.detailSource) {
    const sourceParts = [
      `<span class="recipe-source-chip">${escapeHtml(sourceTypeLabel(recipe.sourceType))}</span>`,
    ];
    if (recipe.sourceTitle)
      sourceParts.push(
        `<span class="meta-text">${escapeHtml(recipe.sourceTitle)}</span>`,
      );
    if (recipe.sourceUrl) {
      sourceParts.push(
        `<a href="${escapeHtml(recipe.sourceUrl)}" target="_blank" rel="noreferrer noopener">Open Source</a>`,
      );
    }
    dom.detailSource.innerHTML = sourceParts.join("");
    setHidden(dom.detailSource, sourceParts.length === 0);
  }
  if (dom.detailTags) {
    const tags = Array.isArray(recipe.tags) ? recipe.tags : [];
    dom.detailTags.innerHTML = tags
      .map((tag) => `<span class="tag-chip">${escapeHtml(tag)}</span>`)
      .join("");
    setHidden(dom.detailTags, tags.length === 0);
  }

  const compatibility = recipeCompatibilityReport(recipe);
  const substitutions = substitutionSuggestionsForRecipe(recipe, compatibility);
  if (dom.detailCompatibility) {
    const statusClass =
      compatibility.status === "ok" ? "compatibility-ok" : "compatibility-block";
    dom.detailCompatibility.innerHTML = `
      <div class="compatibility-status ${statusClass}">${compatibility.status === "ok" ? "Compatible" : "Needs Review"}</div>
      <p class="meta-text">${escapeHtml(compatibility.summary)}</p>
      ${
        compatibility.issues.length
          ? `<ul class="compatibility-list">${compatibility.issues
              .slice(0, 5)
              .map((issue) => `<li>${escapeHtml(issue.message)}</li>`)
              .join("")}</ul>`
          : ""
      }
    `;
    setHidden(dom.detailCompatibility, false);
  }
  if (dom.detailSubstitutions) {
    if (substitutions.length) {
      dom.detailSubstitutions.innerHTML = `
        <h4 style="margin:0 0 8px">Suggested Swaps</h4>
        <ul class="substitution-list">
          ${substitutions
            .map(
              (item) =>
                `<li><strong>${escapeHtml(item.ingredient)}</strong> -> ${escapeHtml(item.suggestion)}<br><span class="meta-text">${escapeHtml(item.note)}</span></li>`,
            )
            .join("")}
        </ul>
      `;
      setHidden(dom.detailSubstitutions, false);
    } else {
      setHidden(dom.detailSubstitutions, true);
      dom.detailSubstitutions.innerHTML = "";
    }
  }

  if (recipe.imageDataUrl) {
    dom.detailImagePreview.innerHTML = `<img src="${escapeHtml(recipe.imageDataUrl)}" alt="Recipe image">`;
    setHidden(dom.detailImagePreview, false);
  } else {
    dom.detailImagePreview.innerHTML = "";
    setHidden(dom.detailImagePreview, true);
  }

  dom.detailIngredients.innerHTML = recipe.ingredients
    .map(
      (ing) => `
    <div class="detail-ingredient">
      <strong>${escapeHtml(ing.name)}</strong>
      <p class="recipe-meta">${escapeHtml(quantityLabel(ing))}</p>
    </div>
  `,
    )
    .join("");

  // Meta pills (cuisine, servings, prep/cook time)
  const meta = recipe.meta;
  if (meta) {
    const metaEntries = [
      meta.cuisine
        ? `<span class="meta-pill"><span class="meta-pill-icon">🌍</span>${escapeHtml(meta.cuisine)}</span>`
        : "",
      meta.servings
        ? `<span class="meta-pill"><span class="meta-pill-icon">🍽️</span>${meta.servings} servings</span>`
        : "",
      meta.prepTime
        ? `<span class="meta-pill"><span class="meta-pill-icon">⏱️</span>Prep: ${escapeHtml(meta.prepTime)}</span>`
        : "",
      meta.cookTime
        ? `<span class="meta-pill"><span class="meta-pill-icon">🔥</span>Cook: ${escapeHtml(meta.cookTime)}</span>`
        : "",
    ].filter(Boolean);
    setHidden(dom.detailMeta, metaEntries.length === 0);
    dom.detailMeta.innerHTML = metaEntries.join("");
  } else {
    setHidden(dom.detailMeta, true);
  }

  const nutrition = normalizeNutritionMeta(recipe.meta?.nutrition);
  if (dom.detailNutrition) {
    if (nutrition) {
      const entries = [
        nutrition.calories ? `<span class="meta-pill"><span class="meta-pill-icon">⚡</span>${escapeHtml(nutrition.calories)} cal</span>` : "",
        nutrition.proteinG ? `<span class="meta-pill"><span class="meta-pill-icon">💪</span>${escapeHtml(nutrition.proteinG)}g protein</span>` : "",
        nutrition.carbsG ? `<span class="meta-pill"><span class="meta-pill-icon">🌾</span>${escapeHtml(nutrition.carbsG)}g carbs</span>` : "",
        nutrition.fatG ? `<span class="meta-pill"><span class="meta-pill-icon">🥑</span>${escapeHtml(nutrition.fatG)}g fat</span>` : "",
        nutrition.fiberG ? `<span class="meta-pill"><span class="meta-pill-icon">🌿</span>${escapeHtml(nutrition.fiberG)}g fiber</span>` : "",
        nutrition.sugarG ? `<span class="meta-pill"><span class="meta-pill-icon">🍯</span>${escapeHtml(nutrition.sugarG)}g sugar</span>` : "",
      ]
        .filter(Boolean)
        .join("");
      dom.detailNutrition.innerHTML = `
        <h4 style="margin:0 0 8px">Nutrition${nutrition.servingSize ? ` <span class="meta-text">(${escapeHtml(nutrition.servingSize)})</span>` : ""}</h4>
        <div class="recipe-meta">${entries}</div>
      `;
      setHidden(dom.detailNutrition, false);
    } else {
      dom.detailNutrition.innerHTML = "";
      setHidden(dom.detailNutrition, true);
    }
  }

  // Steps
  const steps = recipe.steps || [];
  if (steps.length > 0) {
    setHidden(dom.detailStepsSection, false);
    dom.detailSteps.innerHTML = steps
      .map(
        (s) => `
      <div class="step-card">
        <div class="step-header">
          <span class="step-number">${s.step}</span>
          <div class="step-badges">
            ${s.temperature ? `<span class="step-badge step-badge-temp">🌡️ ${escapeHtml(s.temperature)}</span>` : ""}
            ${s.duration ? `<span class="step-badge step-badge-time">⏱️ ${escapeHtml(s.duration)}</span>` : ""}
          </div>
        </div>
        <p class="step-instruction">${escapeHtml(s.instruction)}</p>
      </div>
    `,
      )
      .join("");
  } else {
    setHidden(dom.detailStepsSection, true);
  }
}

function renderAll() {
  renderViews();
  renderNav();
  renderScanMode();
  renderScanImage();
  renderScanStatus();
  renderMealMode();
  renderRecipes();
  renderShopping();
  renderSettings();
  renderPantry();
  renderEditor();
  renderRecipeDetail();
}

// ──────────────────────────────────────────────
// ACTIONS
// ──────────────────────────────────────────────

function showView(viewId) {
  if (!NAV_META[viewId]) return;
  state.ui.activeView = viewId;
  logEvent("info", "view_changed", { view: viewId });
  saveState();
  renderAll();
}

function setSelectedImage(dataUrl) {
  state.selectedImageDataUrl = dataUrl || null;
  state.selectedImages = dataUrl ? [dataUrl] : [];
  state.lowConfidenceWarning = null;
  state.scanErrorMessage = null;
  state.ui.extractProgress = "";
  state.ocrConfidence = 0;
  state.ocrSource = null;
}

async function onSelectImageFile(input) {
  const files = Array.from(input.files || []);
  if (!files.length) return;
  try {
    for (const file of files) {
      if (state.selectedImages.length >= 8) break;
      const dataUrl = await readFileAsDataUrl(file);
      state.selectedImages.push(dataUrl);
    }
    state.selectedImageDataUrl = state.selectedImages[0] || null;
    state.usedSample = false;
    state.lowConfidenceWarning = null;
    state.scanErrorMessage = null;
    state.ui.extractProgress = "";
    state.ocrConfidence = 0;
    state.ocrSource = null;
    logEvent("info", "image_selected", {
      image_count: state.selectedImages.length,
    });
    saveState();
    renderAll();
  } catch (e) {
    state.scanErrorMessage = e.message || "Failed to read image.";
    logEvent("error", "image_select_failed", { error: state.scanErrorMessage });
    renderScanStatus();
  } finally {
    input.value = "";
  }
}

function loadSampleRecipe() {
  const lines = SAMPLE_RECIPE_TEXT.split("\n")
    .map((l) => l.trim())
    .filter(Boolean);
  const ocrLines = lines.map((l) => ({ text: l, confidence: 0.95 }));
  const parseResult = parseIngredientsFromLines(ocrLines);

  state.usedSample = true;
  state.selectedImageDataUrl = null;
  state.selectedImages = [];
  state.rawOCRText = SAMPLE_RECIPE_TEXT;
  state.ocrConfidence = 0.95;
  state.ocrSource = "sample recipe (built-in)";
  state.draftIngredients = parseResult.ingredients;
  state.droppedOCRLines = parseResult.droppedLines;
  state.lowConfidenceWarning = null;
  state.scanErrorMessage = null;
  state.draftSteps = [];
  resetDraftMetadata();
  state.draftRecipeName = deriveRecipeName(SAMPLE_RECIPE_TEXT);
  state.draftTags = ["sample"];
  applyDraftImportMetadata("manual_entry", "sample_recipe", {
    sourceTitle: "Built-in Sample Recipe",
  });
  state.showEditor = true;
  logEvent("info", "sample_recipe_loaded");

  saveState();
  renderAll();
}

async function processSelectedImage() {
  const images =
    state.selectedImages.length > 0
      ? state.selectedImages
      : state.selectedImageDataUrl
        ? [state.selectedImageDataUrl]
        : [];

  if (!images.length) {
    state.scanErrorMessage = "Select or capture a recipe image first.";
    logEvent("warning", "ocr_no_image_selected");
    renderAll();
    return;
  }

  state.isProcessing = true;
  state.scanErrorMessage = null;
  state.lowConfidenceWarning = null;
  state.ui.extractProgress = "Initializing OCR...";
  logEvent("info", "ocr_started", { image_count: images.length });
  renderAll();

  try {
    let allLines = [];
    let allRawText = "";
    let totalConfidence = 0;
    let source = null;
    let fallbackNote = null;
    const allStructuredIngredients = [];
    const allStructuredDropped = [];

    for (let i = 0; i < images.length; i += 1) {
      if (images.length > 1) {
        state.ui.extractProgress = `Processing image ${i + 1} of ${images.length}...`;
        renderScanStatus();
      }
      const extraction = await runOCRExtraction(images[i]);
      allRawText += (allRawText ? "\n" : "") + extraction.rawText;
      totalConfidence += extraction.averageConfidence;
      source = extraction.source;
      if (extraction.fallbackNote) fallbackNote = extraction.fallbackNote;

      if (
        Array.isArray(extraction.ingredients) &&
        extraction.ingredients.length > 0
      ) {
        allStructuredIngredients.push(...extraction.ingredients);
        if (Array.isArray(extraction.droppedLines))
          allStructuredDropped.push(...extraction.droppedLines);
      }
      if (extraction.lines) allLines.push(...extraction.lines);
    }

    const avgConfidence = totalConfidence / images.length;
    const selectedSourceType = normalizeSourceType(
      dom.scanSourceType?.value || "cookbook_photo",
    );
    const hasStructured = allStructuredIngredients.length > 0;
    const parseResult = parseIngredientsFromLines(allLines);
    const metrics = parseResult.metrics || {};
    const effectiveIngredients = hasStructured
      ? allStructuredIngredients
      : parseResult.ingredients;
    const effectiveDropped = hasStructured
      ? allStructuredDropped
      : parseResult.droppedLines;
    const effectiveMetrics = hasStructured ? {} : metrics;

    state.rawOCRText = allRawText;
    state.ocrConfidence = avgConfidence;
    state.ocrSource =
      source + (images.length > 1 ? ` (${images.length} images)` : "");
    state.draftIngredients = effectiveIngredients;
    state.droppedOCRLines = effectiveDropped;
    state.draftRecipeName = deriveRecipeName(allRawText);
    state.draftSteps = [];
    state.draftDescription = "";
    state.draftTags = [];
    applyDraftImportMetadata(selectedSourceType, "ocr_image", {
      sourceTitle: source,
      description: "",
    });
    if (selectedSourceType === "screenshot") state.draftTags = ["screenshot"];
    if (fallbackNote) state.lowConfidenceWarning = fallbackNote;

    const ic = Number.isFinite(effectiveMetrics.ingredientCount)
      ? effectiveMetrics.ingredientCount
      : effectiveIngredients.length;
    const hasMeasured = effectiveIngredients.some(
      (i) => !!trimToNull(i.quantity) || !!trimToNull(i.unit),
    );
    const tooNoisy =
      ic === 0 ||
      (ic === 1 &&
        !hasMeasured &&
        ((effectiveMetrics.avgConfidence || 0) < 0.45 ||
          (effectiveMetrics.qualityScore || 0) < 0.42));

    if (!effectiveIngredients.length || tooNoisy) {
      state.scanErrorMessage = `No ingredient lines found from ${source || "OCR"}. Try clearer images or add ingredients manually.`;
      state.showEditor = false;
      logEvent("warning", "ocr_no_ingredients", {
        source: source || "unknown",
      });
      return;
    }

    if (avgConfidence < state.settings.lowConfidenceThreshold) {
      state.lowConfidenceWarning =
        "Low OCR confidence - review extracted lines before saving.";
      logEvent("warning", "ocr_low_confidence", {
        confidence: avgConfidence.toFixed(2),
        source: source || "unknown",
      });
    } else if ((effectiveMetrics.avgNameQuality || 0) < 0.62) {
      state.lowConfidenceWarning =
        "Ingredient text quality is low - verify each line.";
      logEvent("warning", "ocr_low_name_quality", {
        avg_name_quality: String(
          (effectiveMetrics.avgNameQuality || 0).toFixed(2),
        ),
      });
    }

    state.showEditor = true;
    logEvent("info", "ocr_completed", {
      ingredient_count: effectiveIngredients.length,
      source: source || "unknown",
      confidence: avgConfidence.toFixed(2),
      source_type: selectedSourceType,
    });
  } catch (e) {
    state.scanErrorMessage =
      (e instanceof Error ? e.message : String(e)) ||
      "No readable text detected. Use a recipe screenshot with visible ingredients.";
    logEvent("error", "ocr_failed", { error: state.scanErrorMessage });
  } finally {
    state.isProcessing = false;
    state.ui.extractProgress = "";
    saveState();
    renderAll();
  }
}

function switchScanMode(mode) {
  if (mode !== "recipe" && mode !== "meal") return;
  state.scanMode = mode;
  renderAll();
}

function removePhotoFromGrid(index) {
  if (index < 0 || index >= state.selectedImages.length) return;
  state.selectedImages.splice(index, 1);
  state.selectedImageDataUrl = state.selectedImages[0] || null;
  if (!state.selectedImages.length) {
    state.ocrConfidence = 0;
    state.ocrSource = null;
  }
  renderAll();
}

// ─── Meal Identification ───
async function onSelectMealImageFile(input) {
  const file = input.files?.[0];
  if (!file) return;
  try {
    state.mealImageDataUrl = await readFileAsDataUrl(file);
    state.ui.mealError = null;
    logEvent("info", "meal_image_selected");
    renderAll();
  } catch (e) {
    state.ui.mealError = e.message || "Failed to read image.";
    logEvent("error", "meal_image_select_failed", {
      error: state.ui.mealError,
    });
    renderMealMode();
  } finally {
    input.value = "";
  }
}

function loadSampleMeal() {
  const meal = SAMPLE_MEAL_ANALYSIS;
  state.mealAnalysis = meal;
  resetDraftMetadata();
  state.draftRecipeName = meal.name;
  state.draftDescription = trimToNull(meal.description) || "";
  state.draftIngredients = meal.ingredients.map((ing) => ({
    id: uid(),
    name: ing.name,
    quantity: ing.quantity || null,
    unit: ing.unit || null,
    confidence: 0.95,
    rawLine: `${ing.quantity || ""} ${ing.unit || ""} ${ing.name}`.trim(),
  }));
  state.draftSteps = meal.steps || [];
  state.draftTags = ["meal-ai", "sample"];
  applyDraftImportMetadata("meal_photo_generated", "sample_meal", {
    sourceTitle: "Built-in Sample Meal",
  });
  state.usedSample = true;
  state.showEditor = true;
  logEvent("info", "sample_meal_loaded");
  renderAll();
}

async function runMealAnalysis(imageDataUrl) {
  const body = JSON.stringify({ imageDataUrl });
  const response = await fetch(MEAL_API_ENDPOINT, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body,
  });
  const data = await response.json();
  if (!data.ok) throw new Error(data.error || "Meal analysis failed");
  return data;
}

async function processMealImage() {
  if (!state.mealImageDataUrl) {
    state.ui.mealError = "Select a meal photo first.";
    logEvent("warning", "meal_no_image_selected");
    renderMealMode();
    return;
  }

  state.isProcessing = true;
  state.ui.mealError = null;
  state.ui.mealProgress = "Sending to AI for analysis...";
  logEvent("info", "meal_analysis_started");
  renderAll();

  try {
    const result = await runMealAnalysis(state.mealImageDataUrl);
    state.mealAnalysis = result;
    resetDraftMetadata();
    state.draftRecipeName = result.name || "Identified Meal";
    state.draftDescription = trimToNull(result.description) || "";
    state.draftIngredients = (result.ingredients || []).map((ing) => ({
      id: uid(),
      name: ing.name,
      quantity: ing.quantity || null,
      unit: ing.unit || null,
      confidence: 0.9,
      rawLine: `${ing.quantity || ""} ${ing.unit || ""} ${ing.name}`.trim(),
    }));
    state.draftSteps = result.steps || [];
    state.draftTags = ["meal-ai"];
    applyDraftImportMetadata("meal_photo_generated", "meal_photo_ai", {
      sourceTitle: result.name || "Identified Meal",
      description: trimToNull(result.description) || "",
    });
    state.showEditor = true;
    logEvent("info", "meal_analysis_completed", {
      recipe_name: result.name || "Identified Meal",
      ingredient_count: (result.ingredients || []).length,
    });
  } catch (e) {
    state.ui.mealError =
      (e instanceof Error ? e.message : String(e)) ||
      "Meal analysis failed. Check your API key and try again.";
    logEvent("error", "meal_analysis_failed", { error: state.ui.mealError });
  } finally {
    state.isProcessing = false;
    state.ui.mealProgress = "";
    saveState();
    renderAll();
  }
}

function readDecayForm() {
  if (!dom.decayCategory) {
    return { error: "Decay form is not available." };
  }

  const quantity = Number(dom.decayQuantity?.value);
  const household = Number(dom.decayHousehold?.value);
  const meals = Number(dom.decayMeals?.value);
  const staple = Number(dom.decayStaple?.value);
  const category = String(dom.decayCategory?.value || "").trim();
  const purchaseDate = String(dom.decayDate?.value || "").trim();

  if (!category) return { error: "Select a category." };
  if (!Number.isFinite(quantity) || quantity <= 0)
    return { error: "Quantity must be a positive number." };
  if (!Number.isFinite(household) || household < 1)
    return { error: "Household size must be 1 or more." };
  if (!Number.isFinite(meals) || meals < 1)
    return { error: "Meals per week must be 1 or more." };
  if (![0, 1].includes(staple)) return { error: "Staple must be Yes or No." };

  return {
    payload: {
      item_category: category,
      quantity_oz: quantity,
      household_size: household,
      meals_per_week: meals,
      is_staple: staple,
      purchase_date: purchaseDate || undefined,
    },
  };
}

async function runDecayPrediction(payloadOverride = null) {
  const { payload, error } = payloadOverride
    ? { payload: payloadOverride, error: null }
    : readDecayForm();
  if (error) {
    state.decay = { result: null, error, pending: false };
    renderSettings();
    return;
  }

  state.decay = { result: null, error: null, pending: true };
  renderSettings();
  logEvent("info", "decay_prediction_started");

  try {
    const response = await fetch(DECAY_API_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await response.json();
    if (!response.ok || !data.ok) {
      throw new Error(data.error || "Prediction failed.");
    }

    state.decay = { result: data.result, error: null, pending: false };
    logEvent("info", "decay_prediction_completed", {
      final_use_by_date: String(data.result?.final_use_by_date || ""),
    });
  } catch (e) {
    state.decay = {
      result: null,
      error: e instanceof Error ? e.message : String(e),
      pending: false,
    };
    logEvent("error", "decay_prediction_failed", {
      error: state.decay.error || "unknown",
    });
  } finally {
    renderSettings();
  }
}

function addBlankIngredient() {
  state.draftIngredients.push({
    id: uid(),
    name: "",
    quantity: null,
    unit: null,
    confidence: 0.5,
    rawLine: null,
  });
  renderEditor();
}

function removeIngredient(idx) {
  if (idx < 0 || idx >= state.draftIngredients.length) return;
  state.draftIngredients.splice(idx, 1);
  renderEditor();
}

function saveRecipeAndGenerateList() {
  const name = state.draftRecipeName.trim() || "Untitled Recipe";
  const sanitized = state.draftIngredients
    .map(enrichIngredientFields)
    .map((i) => ({
      ...i,
      name: String(i.name || "").trim(),
      quantity: trimToNull(i.quantity),
      unit: trimToNull(i.unit),
    }))
    .filter((i) => i.name);
  const reliable = sanitized.filter(
    (i) => ingredientNameQuality(i.name) >= 0.5,
  );

  if (!reliable.length) {
    window.alert("Add at least one readable ingredient before saving.");
    return;
  }

  const now = new Date().toISOString();
  const isEditing = !!state.editingRecipeId;
  const existingRecipe = isEditing
    ? state.recipes.find((r) => r.id === state.editingRecipeId)
    : null;
  const draftNutrition = normalizeNutritionMeta(state.draftNutrition);
  const recipe = normalizeRecipe({
    id: isEditing ? state.editingRecipeId : uid(),
    name,
    description: trimToNull(state.draftDescription),
    createdAt: existingRecipe?.createdAt || now,
    updatedAt: now,
    ingredients: reliable,
    imageDataUrl: state.selectedImageDataUrl,
    steps: state.draftSteps || [],
    meta: state.mealAnalysis
      ? {
          cuisine: state.mealAnalysis.cuisine,
          servings: state.mealAnalysis.servings,
          prepTime: state.mealAnalysis.prepTime,
          cookTime: state.mealAnalysis.cookTime,
          nutrition: draftNutrition,
        }
      : existingRecipe?.meta
        ? { ...existingRecipe.meta, nutrition: draftNutrition || existingRecipe.meta.nutrition }
        : draftNutrition
          ? { nutrition: draftNutrition }
          : null,
    tags: state.draftTags || [],
    sourceType: normalizeSourceType(state.draftSourceType),
    sourceTitle: trimToNull(state.draftSourceTitle),
    sourceUrl: cleanUrl(state.draftSourceUrl),
    importMethod: trimToNull(state.draftImportMethod) || "manual",
    importConfidence: existingRecipe?.importConfidence ?? (state.ocrConfidence ? clamp(state.ocrConfidence) : null),
    rawImportText: trimToNull(state.rawOCRText),
  });

  if (isEditing) {
    // Update in place
    const idx = state.recipes.findIndex((r) => r.id === state.editingRecipeId);
    if (idx !== -1) state.recipes[idx] = recipe;
    state.editingRecipeId = null;
    state.showEditor = false;
    state.selectedImageDataUrl = null;
    state.selectedImages = [];
    state.rawOCRText = "";
    state.droppedOCRLines = [];
    state.ocrConfidence = 0;
    state.ocrSource = null;
    state.scanErrorMessage = null;
    state.lowConfidenceWarning = null;
    resetDraftMetadata();
    state.draftIngredients = [];
    state.draftSteps = [];
    state.mealAnalysis = null;
    state.mealImageDataUrl = null;
    logEvent("info", "recipe_updated", {
      recipe_id: recipe.id,
      recipe_name: recipe.name,
    });
    saveState();
    renderAll();
    return;
  }

  const duplicate = findPotentialDuplicateRecipe(recipe);
  if (duplicate) {
    showConfirm(
      "Possible Duplicate Recipe",
      `This looks similar to "${duplicate.recipe.name}" because of ${duplicate.reason}. Save anyway?`,
      () => commitRecipeSave(recipe),
    );
    return;
  }

  commitRecipeSave(recipe);
}

function addRecipeToMealPlan(recipeId) {
  const recipe = recipeById(recipeId);
  if (!recipe) return;
  const date = state.ui.mealPlanSelectedDate || todayIsoDate();
  const mealSlot = state.ui.mealPlanSelectedSlot || "dinner";
  state.mealPlanEntries = state.mealPlanEntries.filter(
    (entry) => !(entry.date === date && entry.mealSlot === mealSlot),
  );
  state.mealPlanEntries.push({
    id: uid(),
    date,
    mealSlot,
    recipeId,
    servingsOverride: null,
  });
  logEvent("info", "meal_plan_entry_added", {
    recipe_id: recipeId,
    date,
    meal_slot: mealSlot,
  });
  saveState();
  renderRecipes();
}

function removeMealPlanEntry(planEntryId) {
  const existing = state.mealPlanEntries.find(
    (entry) => entry.id === planEntryId,
  );
  state.mealPlanEntries = state.mealPlanEntries.filter(
    (entry) => entry.id !== planEntryId,
  );
  logEvent("warning", "meal_plan_entry_removed", {
    plan_entry_id: planEntryId,
    date: existing?.date || "",
  });
  saveState();
  renderRecipes();
}

function adjustMealPlanServings(planEntryId, delta) {
  const entry = state.mealPlanEntries.find((item) => item.id === planEntryId);
  if (!entry) return;
  const recipe = recipeById(entry.recipeId);
  const baseServings = Number(recipe?.meta?.servings);
  const current =
    Number(entry.servingsOverride) ||
    (Number.isFinite(baseServings) && baseServings > 0 ? baseServings : 1);
  const next = Math.max(1, current + delta);
  entry.servingsOverride = next;
  logEvent("info", "meal_plan_servings_updated", {
    plan_entry_id: planEntryId,
    servings: next,
  });
  saveState();
  renderRecipes();
}

function generateShoppingListFromMealPlan() {
  const entries = plannedEntriesForSelectedWeek();
  if (!entries.length) return;
  state.activeShoppingList = shoppingListFromMealPlan(entries);
  logEvent("info", "shopping_list_generated_from_plan", {
    plan_count: entries.length,
  });
  saveState();
  showView("shopping-view");
}

function clearPantryForm() {
  state.ui.pantryEditId = null;
  if (dom.pantryNameInput) dom.pantryNameInput.value = "";
  if (dom.pantryQuantityInput) dom.pantryQuantityInput.value = "";
  if (dom.pantryUnitInput) dom.pantryUnitInput.value = "";
  if (dom.pantryCategoryInput) dom.pantryCategoryInput.value = "Pantry";
  if (dom.pantryDateInput) dom.pantryDateInput.value = todayIsoDate();
}

function saveDietaryProfileFromForm() {
  state.settings.dietaryProfile = normalizeDietaryProfile({
    dietType: dom.dietTypeSelect?.value,
    allergies: dom.allergiesInput?.value,
    excludedIngredients: dom.excludedIngredientsInput?.value,
    macroFocus: dom.macroFocusSelect?.value,
  });
  logEvent("info", "dietary_profile_updated", {
    diet_type: state.settings.dietaryProfile.dietType,
    allergy_count: state.settings.dietaryProfile.allergies.length,
    excluded_count: state.settings.dietaryProfile.excludedIngredients.length,
  });
  saveState();
  renderAll();
}

function updateDraftNutritionField(field, value) {
  state.draftNutrition = {
    ...emptyDraftNutrition(),
    ...(state.draftNutrition || {}),
    [field]: value,
  };
}

function pantryItemById(pantryId) {
  return state.pantryItems.find((item) => item.id === pantryId) || null;
}

function mapPantryCategoryToDecay(category) {
  const value = String(category || "").trim();
  if (value === "Protein") return "Meat";
  if (["Dairy", "Produce", "Pantry", "Frozen", "Other", "Meat"].includes(value)) {
    return value;
  }
  return "Other";
}

function pantryQuantityToDecayOz(pantryItem) {
  const amount = parseAmount(pantryItem?.quantity);
  if (amount === null) return null;
  const unit = normalizedUnit(pantryItem?.unit);
  if (!unit) return amount;
  const factors = {
    oz: 1,
    lb: 16,
    g: 0.035274,
    kg: 35.274,
    cup: 8,
    tbsp: 0.5,
    tsp: 0.1667,
  };
  return Number.isFinite(factors[unit]) ? amount * factors[unit] : null;
}

function canRunDecayCheck(pantryItem) {
  return pantryQuantityToDecayOz(pantryItem) !== null;
}

function prefillDecayFormFromPantryItem(pantryItem) {
  if (!pantryItem || !dom.decayCategory) return;
  const quantityOz = pantryQuantityToDecayOz(pantryItem);
  dom.decayCategory.value = mapPantryCategoryToDecay(pantryItem.category);
  if (Number.isFinite(quantityOz) && dom.decayQuantity) {
    dom.decayQuantity.value = String(Math.max(1, Math.round(quantityOz * 10) / 10));
  }
  if (dom.decayDate) dom.decayDate.value = pantryItem.purchaseDate || todayIsoDate();
  if (dom.decayStaple) {
    dom.decayStaple.value = pantryItem.isStaple || pantryItem.category === "Pantry" ? "1" : "0";
  }
  state.decay = { result: null, error: null, pending: false };
}

function decayPayloadFromPantryItem(pantryItem) {
  const quantityOz = pantryQuantityToDecayOz(pantryItem);
  if (!Number.isFinite(quantityOz) || quantityOz <= 0) {
    return { error: "This pantry item needs a quantity in ounces, pounds, grams, kilograms, cups, tablespoons, or teaspoons before ML can estimate runout." };
  }
  const householdSize = Number(dom.decayHousehold?.value || 3);
  const mealsPerWeek = Number(dom.decayMeals?.value || 7);
  return {
    payload: {
      item_category: mapPantryCategoryToDecay(pantryItem.category),
      quantity_oz: quantityOz,
      household_size: Number.isFinite(householdSize) && householdSize > 0 ? householdSize : 3,
      meals_per_week: Number.isFinite(mealsPerWeek) && mealsPerWeek > 0 ? mealsPerWeek : 7,
      is_staple: pantryItem.isStaple || pantryItem.category === "Pantry" ? 1 : 0,
      purchase_date: pantryItem.purchaseDate || undefined,
    },
  };
}

async function runDecayCheckForPantryItem(pantryItem, source = "pantry") {
  if (!pantryItem) return;
  const { payload, error } = decayPayloadFromPantryItem(pantryItem);
  if (error) {
    state.decay = { result: null, error, pending: false };
    logEvent("warning", "decay_prefill_incomplete", {
      pantry_id: pantryItem.id,
      source,
    });
    if (source === "pantry") {
      prefillDecayFormFromPantryItem(pantryItem);
      showView("settings-view");
      renderSettings();
    }
    return null;
  }
  logEvent("info", "decay_check_started_from_context", {
    pantry_id: pantryItem.id,
    pantry_name: pantryItem.displayName,
    source,
  });
  if (source === "pantry") {
    prefillDecayFormFromPantryItem(pantryItem);
    showView("settings-view");
  }
  await runDecayPrediction(payload);
  if (source === "pantry") {
    renderSettings();
  }
  return state.decay.result || null;
}

function savePantryItem() {
  const pantryItem = normalizePantryItem({
    id: state.ui.pantryEditId,
    displayName: dom.pantryNameInput?.value,
    quantity: dom.pantryQuantityInput?.value,
    unit: dom.pantryUnitInput?.value,
    category: dom.pantryCategoryInput?.value,
    purchaseDate: dom.pantryDateInput?.value,
  });
  if (!pantryItem) return;

  state.pantryItems = state.pantryItems.filter(
    (item) => item.id !== pantryItem.id,
  );
  state.pantryItems.unshift(pantryItem);
  invalidateStaleMLInsights(pantryItem.displayName);
  logEvent("info", "pantry_item_saved", {
    pantry_id: pantryItem.id,
    name: pantryItem.displayName,
  });
  clearPantryForm();
  saveState();
  renderAll();
}

function editPantryItem(pantryId) {
  const item = state.pantryItems.find((entry) => entry.id === pantryId);
  if (!item) return;
  state.ui.pantryEditId = item.id;
  if (dom.pantryNameInput) dom.pantryNameInput.value = item.displayName || "";
  if (dom.pantryQuantityInput)
    dom.pantryQuantityInput.value = item.quantity || "";
  if (dom.pantryUnitInput) dom.pantryUnitInput.value = item.unit || "";
  if (dom.pantryCategoryInput)
    dom.pantryCategoryInput.value = item.category || "Pantry";
  if (dom.pantryDateInput)
    dom.pantryDateInput.value = item.purchaseDate || todayIsoDate();
}

function deletePantryItem(pantryId) {
  const deleted = state.pantryItems.find((item) => item.id === pantryId);
  state.pantryItems = state.pantryItems.filter((item) => item.id !== pantryId);
  if (deleted) invalidateStaleMLInsights(deleted.displayName);
  if (state.ui.pantryEditId === pantryId) clearPantryForm();
  logEvent("warning", "pantry_item_deleted", { pantry_id: pantryId });
  saveState();
  renderAll();
}

function invalidateStaleMLInsights(pantryName) {
  if (!pantryName || !state.activeShoppingList?.items) return;
  const normalized = pantryName.toLowerCase().trim();
  for (const item of state.activeShoppingList.items) {
    if (item.mlInsight && item.mlInsight.pantryName?.toLowerCase().trim() === normalized) {
      item.mlInsight = null;
    }
  }
}

function shoppingItemById(itemId) {
  return (
    state.activeShoppingList?.items?.find((item) => item.id === itemId) || null
  );
}

function upsertPantryFromShoppingItem(itemId, mode = "have") {
  const shoppingItem = shoppingItemById(itemId);
  if (!shoppingItem) return;

  const existingMatch = resolvePantryMatch(shoppingItem)?.item || null;
  const shoppingQty = parseAmount(shoppingItem.quantity);
  const pantryQty = parseAmount(existingMatch?.quantity);
  const shoppingUnit = normalizedUnit(shoppingItem.unit);
  const pantryUnit = normalizedUnit(existingMatch?.unit);
  const sameFamily =
    !existingMatch ||
    !shoppingUnit ||
    !pantryUnit ||
    unitFamily(shoppingUnit) === unitFamily(pantryUnit);
  let nextQuantity =
    trimToNull(shoppingItem.quantity) || existingMatch?.quantity || null;
  let nextUnit = trimToNull(shoppingItem.unit) || existingMatch?.unit || null;

  if (
    existingMatch &&
    sameFamily &&
    shoppingQty !== null &&
    pantryQty !== null
  ) {
    if (shoppingUnit && pantryUnit && shoppingUnit === pantryUnit) {
      nextQuantity = formatAmount(
        mode === "bought"
          ? pantryQty + shoppingQty
          : Math.max(pantryQty, shoppingQty),
      );
      nextUnit = pantryUnit;
    } else {
      nextQuantity = existingMatch.quantity || shoppingItem.quantity || null;
      nextUnit = existingMatch.unit || shoppingItem.unit || null;
    }
  }

  const pantryItem = normalizePantryItem({
    id: existingMatch?.id,
    displayName: existingMatch?.displayName || shoppingItem.name,
    quantity: nextQuantity,
    unit: nextUnit,
    category:
      existingMatch?.category || inferShoppingCategory(shoppingItem.name),
    purchaseDate:
      mode === "bought"
        ? todayIsoDate()
        : existingMatch?.purchaseDate || todayIsoDate(),
    source: mode === "bought" ? "shopping_bought" : "shopping_confirmed",
  });
  if (!pantryItem) return;

  state.pantryItems = state.pantryItems.filter(
    (item) => item.id !== pantryItem.id,
  );
  state.pantryItems.unshift(pantryItem);
  invalidateStaleMLInsights(pantryItem.displayName);
  toggleShoppingItem(itemId, true);
  logEvent("info", "shopping_item_sent_to_pantry", {
    item_id: itemId,
    pantry_id: pantryItem.id,
    mode,
  });
  saveState();
  renderAll();
}

function editPantryFromShoppingItem(itemId) {
  const shoppingItem = shoppingItemById(itemId);
  if (!shoppingItem) return;
  const match = resolvePantryMatch(shoppingItem)?.item;
  const itemName = shoppingItem.name || "item";
  const qty = shoppingItem.quantity ? `${shoppingItem.quantity}${shoppingItem.unit ? " " + shoppingItem.unit : ""}` : "";

  if (match) {
    const currentQty = match.quantity ? `${match.quantity}${match.unit ? " " + match.unit : ""}` : "some";
    showConfirm(
      "Update Pantry",
      `Update "${match.displayName}" in your pantry? Currently: ${currentQty}. This will set quantity to ${qty || "the shopping amount"} and purchase date to today.`,
      () => upsertPantryFromShoppingItem(itemId, "bought"),
    );
  } else {
    showConfirm(
      "Add to Pantry",
      `Add "${itemName}"${qty ? " (" + qty + ")" : ""} to your pantry with today's date?`,
      () => upsertPantryFromShoppingItem(itemId, "bought"),
    );
  }
}

async function runDecayCheckFromShoppingItem(itemId) {
  const shoppingItem = shoppingItemById(itemId);
  if (!shoppingItem) return;
  const pantryMatch = resolvePantryMatch(shoppingItem)?.item;
  if (!pantryMatch) return;
  const { payload } = decayPayloadFromPantryItem(pantryMatch);
  const result = await runDecayCheckForPantryItem(pantryMatch, "shopping");
  if (!result) return;
  const householdSize = payload?.household_size ?? 3;
  const mealsPerWeek = payload?.meals_per_week ?? 7;
  const householdDefaults = !dom.decayHousehold?.value && !dom.decayMeals?.value;
  shoppingItem.mlInsight = {
    finalUseByDate: result.final_use_by_date || null,
    predictedDays: result.predicted_days_to_empty ?? null,
    explanation: result.explanation || "",
    checkedAt: new Date().toISOString(),
    pantryName: pantryMatch.displayName,
    householdSize,
    mealsPerWeek,
    usingDefaults: householdDefaults,
  };
  logEvent("info", "shopping_item_ml_checked", {
    item_id: itemId,
    pantry_name: pantryMatch.displayName,
    final_use_by_date: String(result.final_use_by_date || ""),
  });
  saveState();
  renderShopping();
}

function copyCurrentWeekPlanForward() {
  const currentWeek = plannedEntriesForSelectedWeek();
  if (!currentWeek.length) return;
  const copied = currentWeek.map((entry) => ({
    ...entry,
    id: uid(),
    date: addDaysIso(entry.date, 7),
  }));

  const copiedKeys = new Set(
    copied.map((entry) => `${entry.date}:${entry.mealSlot}`),
  );
  state.mealPlanEntries = state.mealPlanEntries.filter(
    (entry) => !copiedKeys.has(`${entry.date}:${entry.mealSlot}`),
  );
  state.mealPlanEntries.push(...copied);
  logEvent("info", "meal_plan_week_copied", { copied_count: copied.length });
  saveState();
  renderRecipes();
}

function closeEditor() {
  const hasDraftContent = state.draftIngredients.length > 0 || state.draftRecipeName.trim();
  if (hasDraftContent) {
    showConfirm(
      state.editingRecipeId ? "Discard Changes?" : "Discard Draft?",
      state.editingRecipeId
        ? "Your edits have not been saved. Discard them?"
        : "Your imported recipe has not been saved. Discard it?",
      () => {
        state.editingRecipeId = null;
        state.showEditor = false;
        renderAll();
      },
    );
    return;
  }
  state.editingRecipeId = null;
  state.showEditor = false;
  renderAll();
}

function openDetail(recipeId) {
  if (!state.recipes.find((r) => r.id === recipeId)) return;
  state.detail.recipeId = recipeId;
  renderAll();
}

function closeDetail() {
  state.detail.recipeId = null;
  renderAll();
}

function editRecipe(recipeId) {
  const recipe = state.recipes.find((r) => r.id === recipeId);
  if (!recipe) return;

  // Populate draft state from the saved recipe
  state.editingRecipeId = recipeId;
  state.draftRecipeName = recipe.name || "";
  state.draftDescription = recipe.description || "";
  state.draftTags = Array.isArray(recipe.tags) ? [...recipe.tags] : [];
  state.draftSourceType = normalizeSourceType(recipe.sourceType);
  state.draftSourceTitle = recipe.sourceTitle || "";
  state.draftSourceUrl = recipe.sourceUrl || "";
  state.draftImportMethod = recipe.importMethod || "manual";
  state.draftNutrition = recipe.meta?.nutrition
    ? { ...recipe.meta.nutrition }
    : emptyDraftNutrition();
  state.draftIngredients = (recipe.ingredients || []).map((ing) => ({
    name: ing.name || "",
    quantity: ing.quantity || "",
    unit: ing.unit || "",
    confidence: ing.confidence || 1,
    rawLine: ing.rawLine || null,
  }));
  state.draftSteps = (recipe.steps || []).map((s) => ({
    step: s.step,
    instruction: s.instruction || "",
    temperature: s.temperature || "",
    duration: s.duration || "",
  }));

  // Preserve OCR context if available
  state.rawOCRText = recipe.rawImportText || "";
  state.ocrConfidence = recipe.importConfidence || 0;
  state.selectedImageDataUrl = recipe.imageDataUrl || null;
  state.selectedImages = recipe.imageDataUrl ? [recipe.imageDataUrl] : [];
  state.droppedOCRLines = [];
  state.lowConfidenceWarning = null;
  state.scanErrorMessage = null;

  // Close detail, open editor
  state.detail.recipeId = null;
  state.showEditor = true;
  logEvent("info", "recipe_edit_started", { recipe_id: recipeId });
  renderAll();
}

function regenerateShoppingList(recipeId) {
  const recipe = state.recipes.find((r) => r.id === recipeId);
  if (!recipe) return;
  state.activeShoppingList = shoppingListFromRecipe(recipe);
  logEvent("info", "shopping_list_regenerated", { recipe_id: recipeId });
  saveState();
  showView("shopping-view");
}

function mergeAllRecipes() {
  if (state.recipes.length < 2) return;
  state.activeShoppingList = mergeShoppingListFromRecipes(state.recipes);
  logEvent("info", "shopping_list_merged", {
    recipe_count: state.recipes.length,
  });
  saveState();
  showView("shopping-view");
}

function deleteRecipe(recipeId) {
  state.recipes = state.recipes.filter((r) => r.id !== recipeId);
  state.mealPlanEntries = state.mealPlanEntries.filter(
    (entry) => entry.recipeId !== recipeId,
  );
  if (state.detail.recipeId === recipeId) state.detail.recipeId = null;
  logEvent("warning", "recipe_deleted", { recipe_id: recipeId });
  saveState();
  renderAll();
}

function toggleShoppingItem(itemId, checked) {
  const list = state.activeShoppingList;
  if (!list) return;
  const item = list.items.find((i) => i.id === itemId);
  if (!item) return;
  item.isChecked = !!checked;
  logEvent("info", "shopping_item_toggled", {
    item_id: itemId,
    checked: item.isChecked,
  });
  saveState();
  renderShopping();
}

function clearShoppingList() {
  state.activeShoppingList = null;
  logEvent("warning", "shopping_list_cleared");
  saveState();
  renderAll();
}

function resetAllData() {
  localStorage.removeItem(STORAGE_KEY);
  Object.assign(state, makeDefaultState());
  logEvent("warning", "demo_data_reset");
  saveState();
  renderAll();
}

async function copyLogs() {
  const payload = state.logs.map((line) => JSON.stringify(line)).join("\n");
  try {
    await navigator.clipboard.writeText(payload || "No logs.");
    logEvent("info", "logs_copied", { line_count: state.logs.length });
  } catch {
    logEvent("warning", "logs_copy_failed");
  }
  saveState();
  renderSettings();
}

// ─── Confirm Dialog ───
function showConfirm(title, message, onOk) {
  state.pendingConfirm = onOk;
  dom.confirmTitle.textContent = title;
  dom.confirmMessage.textContent = message;
  setHidden(dom.confirmDialog, false);
}

function hideConfirm() {
  state.pendingConfirm = null;
  setHidden(dom.confirmDialog, true);
}

// ──────────────────────────────────────────────
// EVENT BINDING
// ──────────────────────────────────────────────

function bindEvents() {
  // Tab navigation
  dom.tabs.forEach((tab) => {
    tab.addEventListener("click", () => showView(tab.dataset.view));
  });

  // Empty state action buttons
  document.addEventListener("click", (e) => {
    const action = e.target?.dataset?.action;
    if (action === "go-scan") showView("scan-view");
    if (action === "go-recipes") showView("recipes-view");
  });

  // Nav action button
  dom.navAction.addEventListener("click", () => {
    const v = state.ui.activeView;
    if (v === "recipes-view") {
      if (plannedEntriesForSelectedWeek().length) {
        generateShoppingListFromMealPlan();
      } else {
        showConfirm(
          "Shop All Recipes?",
          `This will create a shopping list from all ${state.recipes.length} saved recipes. Use the weekly meal planner above to shop for specific recipes instead.`,
          mergeAllRecipes,
        );
      }
    } else if (v === "shopping-view") {
      showConfirm(
        "Clear Shopping List?",
        "This removes the active list. Saved recipes remain.",
        clearShoppingList,
      );
    }
  });

  // Camera / import
  dom.openCameraBtn.addEventListener("click", () => dom.cameraInput.click());
  dom.importPhotoBtn.addEventListener("click", () => dom.photoInput.click());
  dom.cameraInput.addEventListener("change", () =>
    onSelectImageFile(dom.cameraInput),
  );
  dom.photoInput.addEventListener("change", () =>
    onSelectImageFile(dom.photoInput),
  );

  // Sample recipe
  const sampleBtn = document.getElementById("try-sample-btn");
  if (sampleBtn) sampleBtn.addEventListener("click", loadSampleRecipe);

  // Extract
  dom.extractBtn.addEventListener("click", processSelectedImage);
  if (dom.startBlankRecipeBtn)
    dom.startBlankRecipeBtn.addEventListener("click", beginBlankRecipeDraft);
  if (dom.importUrlBtn)
    dom.importUrlBtn.addEventListener("click", () => {
      void createDraftFromUrlImport();
    });

  // Editor
  dom.editorClose.addEventListener("click", closeEditor);
  dom.editorSave.addEventListener("click", saveRecipeAndGenerateList);
  dom.recipeNameInput.addEventListener("input", () => {
    state.draftRecipeName = dom.recipeNameInput.value;
  });
  if (dom.recipeDescriptionInput)
    dom.recipeDescriptionInput.addEventListener("input", () => {
      state.draftDescription = dom.recipeDescriptionInput.value;
    });
  if (dom.recipeTagsInput)
    dom.recipeTagsInput.addEventListener("input", () => {
      state.draftTags = parseTagsInput(dom.recipeTagsInput.value);
    });
  if (dom.editorSourceType)
    dom.editorSourceType.addEventListener("change", () => {
      state.draftSourceType = normalizeSourceType(dom.editorSourceType.value);
    });
  if (dom.recipeSourceTitleInput)
    dom.recipeSourceTitleInput.addEventListener("input", () => {
      state.draftSourceTitle = dom.recipeSourceTitleInput.value;
    });
  if (dom.recipeSourceUrlInput)
    dom.recipeSourceUrlInput.addEventListener("input", () => {
      state.draftSourceUrl = dom.recipeSourceUrlInput.value;
    });
  if (dom.nutritionServingSizeInput)
    dom.nutritionServingSizeInput.addEventListener("input", () => {
      updateDraftNutritionField(
        "servingSize",
        dom.nutritionServingSizeInput.value,
      );
    });
  if (dom.nutritionCaloriesInput)
    dom.nutritionCaloriesInput.addEventListener("input", () => {
      updateDraftNutritionField(
        "calories",
        dom.nutritionCaloriesInput.value,
      );
    });
  if (dom.nutritionProteinInput)
    dom.nutritionProteinInput.addEventListener("input", () => {
      updateDraftNutritionField(
        "proteinG",
        dom.nutritionProteinInput.value,
      );
    });
  if (dom.nutritionCarbsInput)
    dom.nutritionCarbsInput.addEventListener("input", () => {
      updateDraftNutritionField("carbsG", dom.nutritionCarbsInput.value);
    });
  if (dom.nutritionFatInput)
    dom.nutritionFatInput.addEventListener("input", () => {
      updateDraftNutritionField("fatG", dom.nutritionFatInput.value);
    });
  if (dom.nutritionFiberInput)
    dom.nutritionFiberInput.addEventListener("input", () => {
      updateDraftNutritionField("fiberG", dom.nutritionFiberInput.value);
    });
  if (dom.nutritionSugarInput)
    dom.nutritionSugarInput.addEventListener("input", () => {
      updateDraftNutritionField("sugarG", dom.nutritionSugarInput.value);
    });

  if (dom.recipesSearchInput) {
    dom.recipesSearchInput.addEventListener("input", () => {
      state.ui.recipeSearch = dom.recipesSearchInput.value;
      saveState();
      renderRecipes();
    });
  }
  if (dom.recipesSourceFilter) {
    dom.recipesSourceFilter.addEventListener("change", () => {
      state.ui.recipeSourceFilter = dom.recipesSourceFilter.value || "all";
      saveState();
      renderRecipes();
    });
  }
  if (dom.recipesSortSelect) {
    dom.recipesSortSelect.addEventListener("change", () => {
      state.ui.recipeSort = dom.recipesSortSelect.value || "newest";
      saveState();
      renderRecipes();
    });
  }
  if (dom.recipesCompatibleOnly) {
    dom.recipesCompatibleOnly.addEventListener("change", () => {
      state.ui.recipesCompatibleOnly = dom.recipesCompatibleOnly.checked;
      saveState();
      renderRecipes();
    });
  }
  if (dom.mealPlanDaySelect) {
    dom.mealPlanDaySelect.addEventListener("change", () => {
      state.ui.mealPlanSelectedDate =
        dom.mealPlanDaySelect.value || todayIsoDate();
      saveState();
      renderRecipes();
    });
  }
  if (dom.mealPlanSlotSelect) {
    dom.mealPlanSlotSelect.addEventListener("change", () => {
      state.ui.mealPlanSelectedSlot = dom.mealPlanSlotSelect.value || "dinner";
      saveState();
      renderRecipes();
    });
  }
  if (dom.generatePlanListBtn) {
    dom.generatePlanListBtn.addEventListener(
      "click",
      generateShoppingListFromMealPlan,
    );
  }
  if (dom.copyWeekPlanBtn) {
    dom.copyWeekPlanBtn.addEventListener("click", copyCurrentWeekPlanForward);
  }
  if (dom.pantrySaveBtn)
    dom.pantrySaveBtn.addEventListener("click", savePantryItem);
  if (dom.pantryCancelBtn)
    dom.pantryCancelBtn.addEventListener("click", clearPantryForm);

  dom.ingredientList.addEventListener("input", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLInputElement)) return;
    const idx = Number(t.dataset.index),
      field = t.dataset.field;
    if (!Number.isFinite(idx) || !field) return;
    const ing = state.draftIngredients[idx];
    if (!ing) return;
    if (field === "name") ing.name = t.value;
    if (field === "quantity") ing.quantity = trimToNull(t.value);
    if (field === "unit") ing.unit = trimToNull(t.value);
  });

  dom.ingredientList.addEventListener("click", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement) || t.dataset.action !== "delete-ingredient")
      return;
    removeIngredient(Number(t.dataset.index));
  });

  dom.addIngredientBtn.addEventListener("click", addBlankIngredient);
  if (dom.addStepBtn) dom.addStepBtn.addEventListener("click", addBlankStep);

  if (dom.stepsList) {
    dom.stepsList.addEventListener("input", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement))
        return;
      const idx = Number(t.dataset.stepIndex);
      const field = t.dataset.stepField;
      if (!Number.isFinite(idx) || !field) return;
      const step = state.draftSteps[idx];
      if (!step) return;
      if (field === "instruction") step.instruction = t.value;
      if (field === "temperature") step.temperature = trimToNull(t.value);
      if (field === "duration") step.duration = trimToNull(t.value);
    });

    dom.stepsList.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement) || t.dataset.action !== "delete-step")
        return;
      removeStep(Number(t.dataset.stepIndex));
    });
  }

  // Recipes list
  dom.recipesList.addEventListener("click", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;
    if (t.dataset.action === "filter-tag" && t.dataset.tag) {
      state.ui.recipeSearch = t.dataset.tag;
      saveState();
      renderRecipes();
      return;
    }
    const action = t.dataset.action,
      id = t.dataset.recipeId;
    if (!action || !id) return;
    if (action === "open-detail") openDetail(id);
    if (action === "plan-recipe") addRecipeToMealPlan(id);
    if (action === "generate-list") regenerateShoppingList(id);
    if (action === "delete-recipe") {
      showConfirm("Delete Recipe?", "This cannot be undone.", () =>
        deleteRecipe(id),
      );
    }
  });

  if (dom.mealPlanList) {
    dom.mealPlanList.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      if (t.dataset.action === "increase-servings" && t.dataset.planEntryId) {
        adjustMealPlanServings(t.dataset.planEntryId, 1);
        return;
      }
      if (t.dataset.action === "decrease-servings" && t.dataset.planEntryId) {
        adjustMealPlanServings(t.dataset.planEntryId, -1);
        return;
      }
      if (t.dataset.action === "remove-plan-entry" && t.dataset.planEntryId) {
        removeMealPlanEntry(t.dataset.planEntryId);
      }
    });
  }

  if (dom.pantryList) {
    dom.pantryList.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      if (t.dataset.action === "predict-pantry" && t.dataset.pantryId) {
        void runDecayCheckForPantryItem(pantryItemById(t.dataset.pantryId), "pantry");
        return;
      }
      if (t.dataset.action === "edit-pantry" && t.dataset.pantryId) {
        editPantryItem(t.dataset.pantryId);
        return;
      }
      if (t.dataset.action === "delete-pantry" && t.dataset.pantryId) {
        deletePantryItem(t.dataset.pantryId);
      }
    });
  }

  // Shopping list
  dom.shoppingList.addEventListener("change", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLInputElement) || t.dataset.action !== "toggle-item")
      return;
    toggleShoppingItem(t.dataset.itemId, t.checked);
  });
  dom.shoppingList.addEventListener("click", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement) || !t.dataset.action || !t.dataset.itemId)
      return;
    if (t.dataset.action === "confirm-have-item") {
      upsertPantryFromShoppingItem(t.dataset.itemId, "have");
      return;
    }
    if (t.dataset.action === "bought-item") {
      upsertPantryFromShoppingItem(t.dataset.itemId, "bought");
      return;
    }
    if (t.dataset.action === "ml-check-item") {
      void runDecayCheckFromShoppingItem(t.dataset.itemId);
      return;
    }
    if (t.dataset.action === "edit-item-pantry") {
      editPantryFromShoppingItem(t.dataset.itemId);
    }
  });

  // Settings
  dom.cloudToggle.addEventListener("change", () => {
    state.settings.useCloudFallback = dom.cloudToggle.checked;
    saveState();
  });

  dom.thresholdSlider.addEventListener("input", () => {
    state.settings.lowConfidenceThreshold = clamp(
      Number(dom.thresholdSlider.value),
      0.4,
      0.95,
    );
    dom.thresholdValue.textContent = String(
      Math.round(state.settings.lowConfidenceThreshold * 100),
    );
    saveState();
  });

  if (dom.dietTypeSelect) {
    dom.dietTypeSelect.addEventListener("change", saveDietaryProfileFromForm);
  }
  if (dom.allergiesInput) {
    dom.allergiesInput.addEventListener("change", saveDietaryProfileFromForm);
  }
  if (dom.excludedIngredientsInput) {
    dom.excludedIngredientsInput.addEventListener(
      "change",
      saveDietaryProfileFromForm,
    );
  }
  if (dom.macroFocusSelect) {
    dom.macroFocusSelect.addEventListener("change", saveDietaryProfileFromForm);
  }

  if (dom.decayRunBtn) {
    dom.decayRunBtn.addEventListener("click", () => {
      void runDecayPrediction();
    });
  }

  dom.resetAllBtn.addEventListener("click", () => {
    showConfirm(
      "Reset All Data?",
      "This clears all recipes, shopping lists, and settings.",
      resetAllData,
    );
  });

  if (dom.copyLogsBtn) {
    dom.copyLogsBtn.addEventListener("click", () => {
      void copyLogs();
    });
  }

  // Detail sheet
  dom.detailClose.addEventListener("click", closeDetail);
  if (dom.detailEdit) {
    dom.detailEdit.addEventListener("click", () => {
      if (state.detail.recipeId) editRecipe(state.detail.recipeId);
    });
  }
  dom.detailGenerate.addEventListener("click", () => {
    const recipe = state.detail.recipeId
      ? state.recipes.find((r) => r.id === state.detail.recipeId)
      : null;
    if (recipe) regenerateShoppingList(recipe.id);
  });

  // Confirm dialog
  dom.confirmCancel.addEventListener("click", hideConfirm);
  dom.confirmOk.addEventListener("click", () => {
    const fn = state.pendingConfirm;
    hideConfirm();
    if (typeof fn === "function") fn();
  });

  // ─── Mode Toggle ───
  dom.modeRecipeBtn.addEventListener("click", () => switchScanMode("recipe"));
  dom.modeMealBtn.addEventListener("click", () => switchScanMode("meal"));

  // ─── Photo Grid (remove & add more) ───
  dom.photoGrid.addEventListener("click", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;
    if (t.dataset.action === "remove-photo") {
      removePhotoFromGrid(Number(t.dataset.index));
    }
    if (t.id === "add-more-photos-btn") {
      dom.photoInput.click();
    }
  });

  // ─── Meal Mode ───
  dom.mealCameraBtn.addEventListener("click", () =>
    dom.mealCameraInput.click(),
  );
  dom.mealImportBtn.addEventListener("click", () => dom.mealPhotoInput.click());
  dom.mealCameraInput.addEventListener("change", () =>
    onSelectMealImageFile(dom.mealCameraInput),
  );
  dom.mealPhotoInput.addEventListener("change", () =>
    onSelectMealImageFile(dom.mealPhotoInput),
  );
  dom.analyzeMealBtn.addEventListener("click", processMealImage);

  const sampleMealBtn = document.getElementById("try-sample-meal-btn");
  if (sampleMealBtn) sampleMealBtn.addEventListener("click", loadSampleMeal);
}

// ──────────────────────────────────────────────
// INIT
// ──────────────────────────────────────────────

function init() {
  setParserDeps({ uid, trimToNull, clamp });
  logEvent("info", "mobile_demo_loaded");
  bindEvents();
  renderAll();
}

init();
